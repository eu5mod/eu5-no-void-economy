# Copy this file to `.cbp.local.env` and keep the real file uncommitted.
#
# Path to the vanilla EU5 `game/in_game/common` directory.
EU5_GAME_COMMON_DIR="<EU5_INSTALL_DIR>/game/in_game/common"
# Optional explicit source for the generated CBP location overrides. When it is
# unset, generate_all derives this path from EU5_GAME_COMMON_DIR.
# EU5_GAME_LOCATION_STATIC_MODIFIERS_FILE="<EU5_INSTALL_DIR>/game/main_menu/common/static_modifiers/location.txt"
# Optional explicit path when the defines file cannot be derived from the common path.
# EU5_GAME_DEFINES_FILE="<EU5_INSTALL_DIR>/game/loading_screen/common/defines/00_defines.txt"

# Local developer runtime mode.
# This controls ModeU5 debug behaviour independently from the EU5 engine
# --debug_mode launch argument. Keep false for performance comparisons with
# normal users; set true only when you want ModeU5 debug captures/metrics.
MODEU5_ENABLE_DEBUG_RUNTIME=false

# US-09 static economy overrides.
# Generates complete vanilla-file overrides from the currently installed EU5 build.
# Keep true when you want US-09 to override the corresponding vanilla definitions.
MODEU5_ENABLE_US09_STATIC_OVERRIDES=true
MODEU5_US09_BONUS_PERCENT=8 # example: 8 for +8% RGO/building production
MODEU5_US09_RGO_PRICE_OFFSET_PERCENT=8 # independent inverse offset for RGO expansion prices
MODEU5_US08_BUILDING_MAINTENANCE_MULTIPLIER=0.7 # non-trade buildings, product of vanilla
MODEU5_US08_TRADE_BUILDING_MAINTENANCE_MULTIPLIER=0.5 # trade buildings, product of vanilla
# Optional. If unset, trade-capacity fields use MODEU5_US09_BONUS_PERCENT.
# MODEU5_US09_TRADE_CAPACITY_BONUS_PERCENT=15 # example : 15 for +15% trade capacity
EXTRA_BURGHER_PROMOTION_SPEED=10 # example : 10 for +10% Burgher base promotion speed
EXTRA_LABORER_PROMOTION_SPEED=10 # example : 10 for +10% Laborer base promotion speed
MODEU5_PRICE_SCALE_FROM_ECO_BASE=0
MODEU5_GOODS_RGO_BASE_COST=1
MODEU5_GOODS_RGO_PRICE_SCALE=0

# US-177 food controls are deliberately independent.
MODEU5_US177_FOOD_PRICE=0.3 #REPLACEMENT VALUE
MODEU5_US177_FOOD_PRODUCTION_DIVISOR=3 #PRODUCT OFF VANILLA
MODEU5_US177_MINTING_MULTIPLIER=2  #PRODUCT OFF VANILLA

# Generated location static-modifier balance. The generator preserves every
# other line from the currently installed vanilla blocks.
CBP_EXPENSIVE_FOOD_POPULATION_GROWTH=0  #REPLACEMENT VALUE
CBP_CHEAP_FOOD_POPULATION_GROWTH=0.001  #REPLACEMENT VALUE
CBP_MARKET_CENTER_STOCKPILE_CAPACITY=0  #REPLACEMENT VALUE
CBP_SURPLUS_JOBS_MIGRATION_ATTRACTION=0.2  #REPLACEMENT VALUE

# Used by the generated complete vanilla 00_defines.txt override.
MODEU5_US15_BONUS_PERCENT=0.015  #REPLACEMENT VALUE : 0.015 for 1.5% per building level
MODEU5_US16_CASSUS_BELLI_VALIDITY=12 # example : 12 for 12 years

# PR157 review-popup QR overlay local overrides.
# These are optional; CI falls back to the committed URL/default layout when they are absent.
# The default production event source is review_popup_1524_event_choice_situation_wide_source.svg.
MODEU5_REVIEW_POPUP_QR_URL="https://forum.paradoxplaza.com/forum/threads/cbp-trade-loop-fix-trades-are-not-profitable-both-ways.1935592/"
