# Copy this file to `.modeu5.local.env` and keep the real file uncommitted.
#
# Path to the vanilla EU5 `game/in_game/common` directory.
EU5_GAME_COMMON_DIR="<EU5_INSTALL_DIR>/game/in_game/common"

# Local developer runtime mode.
# This controls ModeU5 debug behaviour independently from the EU5 engine
# --debug_mode launch argument. Keep false for performance comparisons with
# normal users; set true only when you want ModeU5 debug captures/metrics.
MODEU5_ENABLE_DEBUG_RUNTIME=false

# US-09 static economy overrides.
# Generates package-local override files under packages/modeu5_economy_rebalance/in_game/common.
# Keep true when you want US-09 to override the corresponding vanilla static definitions.
MODEU5_ENABLE_US09_STATIC_OVERRIDES=true
MODEU5_US09_BONUS_PERCENT=10 # example : 10 for 10%

MODEU5_US15_BONUS_PERCENT=0.015 # example : 1.5%
MODEU5_US16_CASSUS_BELLI_VALIDITY=12 # example : 12 for 12 years
