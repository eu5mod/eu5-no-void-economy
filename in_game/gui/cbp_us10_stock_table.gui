# Generated by tools/generate_us10_ui_helpers.sh.
# Do not edit manually.
#
# ModeU5 US-10 reusable stock table templates.
#
# Kept separate from the Plan A mounting point so the table can be reused if
# Plan B later generates a full production_lateralview.gui override.
#
# US-10 spec columns:
# Good | Country Stocks | Market Stocks | Overproduction | Production Efficiency
#
# Row visibility is generated for every ModeU5 stock good from tools/cbp_goods.sh
# and is based on the selected-market vanilla production trigger, with stock
# presence kept as a temporary visibility fallback while diagnostics stabilize.

template cbp_us10_stock_header_cell_good {
	layoutpolicy_horizontal = fixed
	minimumsize = { 38 22 }
	maximumsize = { 38 22 }
	autoresize = no
	align = center|nobaseline
	fontsize = 11
	default_format = "#bold"
	block "text" { raw_text = "" }
}

template cbp_us10_stock_header_cell_stock {
	layoutpolicy_horizontal = fixed
	minimumsize = { 84 22 }
	maximumsize = { 84 22 }
	autoresize = no
	align = right|nobaseline
	fontsize = 11
	default_format = "#bold"
	block "text" { raw_text = "" }
}

template cbp_us10_stock_header_cell_overproduction {
	layoutpolicy_horizontal = fixed
	minimumsize = { 74 22 }
	maximumsize = { 74 22 }
	autoresize = no
	align = right|nobaseline
	fontsize = 11
	default_format = "#bold"
	block "text" { raw_text = "" }
}

template cbp_us10_stock_header_cell_efficiency {
	layoutpolicy_horizontal = fixed
	minimumsize = { 62 22 }
	maximumsize = { 62 22 }
	autoresize = no
	align = right|nobaseline
	fontsize = 11
	default_format = "#bold"
	block "text" { raw_text = "" }
}

template cbp_us10_stock_value_cell_stock {
	layoutpolicy_horizontal = fixed
	minimumsize = { 84 22 }
	maximumsize = { 84 22 }
	autoresize = no
	align = right|nobaseline
	fontsize = 12
	block "text" { raw_text = "" }
}

template cbp_us10_stock_value_cell_overproduction {
	layoutpolicy_horizontal = fixed
	minimumsize = { 74 22 }
