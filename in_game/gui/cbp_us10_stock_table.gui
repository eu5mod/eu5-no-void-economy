	block "text" { raw_text = "" }
}

template cbp_us10_stock_value_cell_efficiency {
	layoutpolicy_horizontal = fixed
	minimumsize = { 62 22 }
	maximumsize = { 62 22 }
	autoresize = no
	align = right|nobaseline
	fontsize = 12
	block "text" { raw_text = "" }
}

template cbp_us10_stock_good_icon_cell {
	layoutpolicy_horizontal = fixed
	minimumsize = { 38 24 }
	maximumsize = { 38 24 }

	icon = {
		parentanchor = center
		size = { 22 22 }
		texture = "gfx/interface/icons/trade_goods/icon_goods_wheat.dds"
		texture_density = 2
	}
}

template cbp_us10_stock_row {
	layoutpolicy_horizontal = fixed
	layoutpolicy_vertical = fixed
	minimumsize = { 370 26 }
	maximumsize = { 370 26 }
	spacing = 4

	block "good" {
		widget = {
			using = cbp_us10_stock_good_icon_cell
		}
	}
	block "country_stocks" { text_single = { using = cbp_us10_stock_value_cell_stock } }
	block "market_stocks" { text_single = { using = cbp_us10_stock_value_cell_stock } }
	block "overproduction" { text_single = { using = cbp_us10_stock_value_cell_overproduction } }
	block "production_efficiency" { text_single = { using = cbp_us10_stock_value_cell_efficiency } }
}

template cbp_us10_stock_table {
	layoutpolicy_horizontal = fixed
	layoutpolicy_vertical = expanding
	minimumsize = { 520 760 }
	maximumsize = { 520 760 }
	using = bg_window_default_alt

	vbox = {
		layoutpolicy_horizontal = fixed
		layoutpolicy_vertical = expanding
		minimumsize = { 504 744 }
		maximumsize = { 504 744 }
		margin = { 8 8 }
		spacing = 5

		hbox = {
			layoutpolicy_horizontal = fixed
			layoutpolicy_vertical = fixed
			minimumsize = { 370 24 }
			maximumsize = { 370 24 }
			spacing = 4
			text_single = { using = cbp_us10_stock_header_cell_good blockoverride "text" { raw_text = "Good" } }
			text_single = { using = cbp_us10_stock_header_cell_stock blockoverride "text" { raw_text = "Country" } }
			text_single = { using = cbp_us10_stock_header_cell_stock blockoverride "text" { raw_text = "Market" } }
			text_single = { using = cbp_us10_stock_header_cell_overproduction blockoverride "text" { raw_text = "Overprod." } }
			text_single = { using = cbp_us10_stock_header_cell_efficiency blockoverride "text" { raw_text = "Eff." } }
		}

		scrollarea = {
			layoutpolicy_horizontal = fixed
			layoutpolicy_vertical = expanding
			minimumsize = { 504 710 }
			maximumsize = { 504 710 }
			scrollbarpolicy_horizontal = always_off
			autoresizescrollarea = no

			scrollbar_vertical = { using = Scrollbar_Vertical }

			scrollwidget = {
				vbox = {
					layoutpolicy_horizontal = fixed
					set_parent_dimension_to_minimum = height
					spacing = 2

					hbox = {
						using = cbp_us10_stock_row
						visible = "[GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('gui_cbp_us10_ui_cotton_visible').GetValue, '(CFixedPoint)0')]"
						blockoverride "good" { widget = { using = cbp_us10_stock_good_icon_cell icon = { parentanchor = center size = { 22 22 } texture = "gfx/interface/icons/trade_goods/icon_goods_cotton.dds" texture_density = 2 } } }
						blockoverride "country_stocks" { text_single = { using = cbp_us10_stock_value_cell_stock blockoverride "text" { raw_text = "[Player.MakeScope.GetVariable('gui_cbp_us10_ui_cotton_country_stock').GetValue|2]/[Player.MakeScope.GetVariable('gui_cbp_us10_ui_cotton_country_capacity').GetValue|2]" } } }
						blockoverride "market_stocks" { text_single = { using = cbp_us10_stock_value_cell_stock blockoverride "text" { raw_text = "[Player.MakeScope.GetVariable('gui_cbp_us10_ui_cotton_market_stock').GetValue|2]/[Player.MakeScope.GetVariable('gui_cbp_us10_ui_cotton_market_capacity').GetValue|2]" } } }
						blockoverride "overproduction" { text_single = { using = cbp_us10_stock_value_cell_overproduction blockoverride "text" { raw_text = "[Player.MakeScope.GetVariable('gui_cbp_us10_ui_cotton_overproduction_percent').GetValue|2]%" } } }
						blockoverride "production_efficiency" { text_single = { using = cbp_us10_stock_value_cell_efficiency blockoverride "text" { raw_text = "n/a" } } }
					}
					hbox = {
						using = cbp_us10_stock_row
						visible = "[GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('gui_cbp_us10_ui_sugar_visible').GetValue, '(CFixedPoint)0')]"
