# ModeU5 US-10 stock panel templates.
# Safe placeholder panel: no datamodel, no scripted GUI execution, no dynamic
# market list. This validates the injected tab/body lifecycle before adding
# market cards and stock rows back.

template modeu5_us10_stock_panel {
	# Injected as a child of production_main_tabs. Keep this container inert.
	size = { 0 0 }
	alwaystransparent = yes

	window = {
		parentanchor = top|left
		widgetanchor = top|left
		position = { -560 45 }
		size = { 540 240 }
		using = bg_window_default_alt
		movable = yes
		alwaystransparent = no

		vbox = {
			margin = { 14 12 }
			spacing = 10

			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 8

				text_single = {
					layoutpolicy_horizontal = expanding
					autoresize = no
					align = left|nobaseline
					default_format = "#bold"
					raw_text = "ModeU5 Stocks"
				}

				button_regular = {
					size = { 80 30 }
					raw_text = "Close"
					using = bg_button_flavor_4
					onclick = "[GetVariableSystem.Clear('modeu5_us10_stock_tab')]"
					tooltipwidget = { BasicFunctionalTooltip = {} }
				}
			}

			widget = {
				layoutpolicy_horizontal = expanding
				size = { -1 120 }
				using = bg_age_event_frame

				vbox = {
					layoutpolicy_horizontal = expanding
					margin = { 10 8 }
					spacing = 8

					text_multi = {
						layoutpolicy_horizontal = expanding
						autoresize = yes
						raw_text = "Safe UI placeholder. The tab and body are now injected into Production without OpenLateralView, without scripted_widgets, and without executing the US-10 refresh/read-model."
					}

					text_multi = {
						layoutpolicy_horizontal = expanding
						autoresize = yes
						raw_text = "Next step after this is stable: add the market selector back as a lightweight visual block, then add the stock rows."
					}
				}
			}
		}
	}
}
