# ModeU5 US-10 stock panel prototype.
# This is not a lateralview: it uses the GUI VariableSystem.

template modeu5_us10_ui_panel_header_cell {
	layoutpolicy_horizontal = expanding
	layoutstretchfactor_horizontal = 1
	autoresize = no
	align = left|nobaseline
	default_format = "#bold"
	block "text" { text = "" }
}

template modeu5_us10_ui_panel_value_cell {
	layoutpolicy_horizontal = expanding
	layoutstretchfactor_horizontal = 1
	autoresize = no
	align = left|nobaseline
	block "text" { text = "" }
}

template modeu5_us10_ui_good_row_cotton {
	visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.GetVariable('modeu5_us10_ui_cotton_produced').GetValue,'(CFixedPoint)0')]"
	layoutpolicy_horizontal = expanding
	spacing = 8
	text_single = { using = modeu5_us10_ui_panel_value_cell blockoverride "text" { text = "modeu5_us10_ui.good.cotton" } }
	text_single = { using = modeu5_us10_ui_panel_value_cell blockoverride "text" { text = "[GetPlayer.MakeScope.GetVariable('modeu5_us10_ui_cotton_country_stock').GetValue|2]/[GetPlayer.MakeScope.GetVariable('modeu5_us10_ui_cotton_country_capacity').GetValue|2]" } }
	text_single = { using = modeu5_us10_ui_panel_value_cell blockoverride "text" { text = "[GetPlayer.MakeScope.GetVariable('modeu5_us10_ui_cotton_market_stock').GetValue|2]/[GetPlayer.MakeScope.GetVariable('modeu5_us10_ui_cotton_market_capacity').GetValue|2]" } }
	text_single = { using = modeu5_us10_ui_panel_value_cell blockoverride "text" { raw_text = "[GetPlayer.MakeScope.GetVariable('modeu5_us10_ui_cotton_overproduction_percent').GetValue|2]%" } }
}

