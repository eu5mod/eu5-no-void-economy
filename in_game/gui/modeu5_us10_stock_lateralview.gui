lateralview = {
	name = "modeu5_us10_stock_lateralview"
	widgetid = "modeu5_us10_stock_lateralview"

	blockoverride "panel_header" {
		window_header_alt = {
			blockoverride "header_text" {
				text = "modeu5_us10_ui.title"
			}
			blockoverride "window_header_alt_color_texture"{
				using = color_production_texture
			}
		}
	}

	blockoverride "panel_content" {
		header_main_tabs = { #TABS
			blockoverride "content" {
				using = production_main_tabs
			}
		}

		widget = {
			using = layoutpolicy_expanding

			vbox = {
				using = bg_main_inner_alt
				using = bg_main_inner_image_alt
				blockoverride "image" {
					texture = "gfx/interface/illustrations/bg/bg_production.dds"
				}
				using = window_main_tabs_margin_alt
				spacing = 10

				overlappingitembox = {
					visible = no
					state = {
						name = modeu5_us10_ui_open_refresh
						trigger_on_create = yes
						duration = 1
						on_finish = "[GetScriptedGui('modeu5_us10_ui_refresh_on_click').Execute(GuiScope.SetRoot(Player.MakeScope).End)]"
					}
				}

				text_multi = {
					layoutpolicy_horizontal = expanding
					autoresize = no
					size = { -1 48 }
					text = "modeu5_us10_ui.subtitle"
				}

				widget = {
					layoutpolicy_horizontal = expanding
					size = { -1 58 }
					using = bg_age_event_frame

					hbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						margin = { 10 8 }
						spacing = 8

						text_single = {
							layoutpolicy_horizontal = expanding
							autoresize = no
							align = left|nobaseline
							text = "modeu5_us10_ui.selected_market"
						}

						text_single = {
							size = { 90 24 }
							autoresize = no
							align = right|nobaseline
							text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_selected_market_index').GetValue|0]/[Player.MakeScope.GetVariable('modeu5_us10_ui_market_count').GetValue|0]"
						}

						button_regular = {
							size = { 92 28 }
							text = "modeu5_us10_ui.refresh"
							using = bg_button_flavor_4
							onclick = "[GetScriptedGui('modeu5_us10_ui_refresh_on_click').Execute(GuiScope.SetRoot(Player.MakeScope).End)]"
							tooltipwidget = { BasicFunctionalTooltip = {} }
						}

						button_regular = {
							size = { 110 28 }
							text = "modeu5_us10_ui.next_market"
							using = bg_button_flavor_4
							onclick = "[GetScriptedGui('modeu5_us10_ui_next_market_on_click').Execute(GuiScope.SetRoot(Player.MakeScope).End)]"
							tooltipwidget = { BasicFunctionalTooltip = {} }
						}
					}
				}

				widget = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					using = bg_age_event_frame

					vbox = {
						layoutpolicy_horizontal = expanding
						margin = { 10 8 }
						spacing = 6

						hbox = {
							layoutpolicy_horizontal = expanding
							spacing = 8

							text_single = { layoutpolicy_horizontal = expanding layoutstretchfactor_horizontal = 1 autoresize = no align = left|nobaseline default_format = "#bold" text = "modeu5_us10_ui.column.good" }
							text_single = { layoutpolicy_horizontal = expanding layoutstretchfactor_horizontal = 1 autoresize = no align = right|nobaseline default_format = "#bold" text = "modeu5_us10_ui.column.country_stocks" }
							text_single = { layoutpolicy_horizontal = expanding layoutstretchfactor_horizontal = 1 autoresize = no align = right|nobaseline default_format = "#bold" text = "modeu5_us10_ui.column.market_stocks" }
							text_single = { layoutpolicy_horizontal = expanding layoutstretchfactor_horizontal = 1 autoresize = no align = right|nobaseline default_format = "#bold" text = "modeu5_us10_ui.column.overproduction" }
						}

						hbox = {
							layoutpolicy_horizontal = expanding
							spacing = 8
							text_single = { layoutpolicy_horizontal = expanding layoutstretchfactor_horizontal = 1 autoresize = no align = left|nobaseline text = "modeu5_us10_ui.good.wheat" }
							text_single = { layoutpolicy_horizontal = expanding layoutstretchfactor_horizontal = 1 autoresize = no align = right|nobaseline text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_wheat_country_stock').GetValue|2]/[Player.MakeScope.GetVariable('modeu5_us10_ui_wheat_country_capacity').GetValue|2]" }
							text_single = { layoutpolicy_horizontal = expanding layoutstretchfactor_horizontal = 1 autoresize = no align = right|nobaseline text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_wheat_market_stock').GetValue|2]/[Player.MakeScope.GetVariable('modeu5_us10_ui_wheat_market_capacity').GetValue|2]" }
							text_single = { layoutpolicy_horizontal = expanding layoutstretchfactor_horizontal = 1 autoresize = no align = right|nobaseline raw_text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_wheat_overproduction_percent').GetValue|2]%" }
						}

						hbox = {
							layoutpolicy_horizontal = expanding
							spacing = 8
							text_single = { layoutpolicy_horizontal = expanding layoutstretchfactor_horizontal = 1 autoresize = no align = left|nobaseline text = "modeu5_us10_ui.good.iron" }
							text_single = { layoutpolicy_horizontal = expanding layoutstretchfactor_horizontal = 1 autoresize = no align = right|nobaseline text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_iron_country_stock').GetValue|2]/[Player.MakeScope.GetVariable('modeu5_us10_ui_iron_country_capacity').GetValue|2]" }
							text_single = { layoutpolicy_horizontal = expanding layoutstretchfactor_horizontal = 1 autoresize = no align = right|nobaseline text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_iron_market_stock').GetValue|2]/[Player.MakeScope.GetVariable('modeu5_us10_ui_iron_market_capacity').GetValue|2]" }
							text_single = { layoutpolicy_horizontal = expanding layoutstretchfactor_horizontal = 1 autoresize = no align = right|nobaseline raw_text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_iron_overproduction_percent').GetValue|2]%" }
						}

						hbox = {
							layoutpolicy_horizontal = expanding
							spacing = 8
							text_single = { layoutpolicy_horizontal = expanding layoutstretchfactor_horizontal = 1 autoresize = no align = left|nobaseline text = "modeu5_us10_ui.good.tools" }
							text_single = { layoutpolicy_horizontal = expanding layoutstretchfactor_horizontal = 1 autoresize = no align = right|nobaseline text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_tools_country_stock').GetValue|2]/[Player.MakeScope.GetVariable('modeu5_us10_ui_tools_country_capacity').GetValue|2]" }
							text_single = { layoutpolicy_horizontal = expanding layoutstretchfactor_horizontal = 1 autoresize = no align = right|nobaseline text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_tools_market_stock').GetValue|2]/[Player.MakeScope.GetVariable('modeu5_us10_ui_tools_market_capacity').GetValue|2]" }
							text_single = { layoutpolicy_horizontal = expanding layoutstretchfactor_horizontal = 1 autoresize = no align = right|nobaseline raw_text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_tools_overproduction_percent').GetValue|2]%" }
						}

						expand = {}
					}
				}

				text_multi = {
					layoutpolicy_horizontal = expanding
					autoresize = no
					size = { -1 58 }
					text = "modeu5_us10_ui.read_only_note"
				}
			}
		}
	}
}
