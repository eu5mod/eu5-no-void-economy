window = {
	name = "modeu5_us10_stock"
	position = { 0 102 }
	size = { 620 900 }
	alwaystransparent = yes

	vbox = {
		size = { 620 900 }
		using = bg_main_inner_alt
		using = window_main_tabs_margin_alt
		spacing = 8

		text_single = {
			layoutpolicy_horizontal = expanding
			autoresize = no
			align = center|nobaseline
			default_format = "#bold"
			text = "modeu5_us10_ui.title"
		}

		header_main_tabs = {
			blockoverride "content" {
				using = production_main_tabs
			}
		}

		text_multi = {
			layoutpolicy_horizontal = expanding
			autoresize = no
			size = { -1 42 }
			text = "modeu5_us10_ui.subtitle"
		}

		widget = {
			layoutpolicy_horizontal = expanding
			size = { -1 120 }
			using = bg_age_event_frame
			vbox = {
				layoutpolicy_horizontal = expanding
				margin = { 8 8 }
				spacing = 6
				text_single = { layoutpolicy_horizontal = expanding autoresize = no align = center|nobaseline raw_text = "US-10 stock widget loaded" }
			}
		}
	}
}
