# ModeU5 US-10 stock panel templates.
#
# Plan A placeholder: no datamodel, no scripted GUI execution, no dynamic
# market list. This is mounted inside the existing Production content flow by
# zz_modeu5_us10_production_subtabs.gui.

template modeu5_us10_stock_panel {
	visible = "[GetVariableSystem.Exists('modeu5_us10_stock_tab')]"
	layoutpolicy_horizontal = expanding
	size = { -1 170 }
	using = bg_age_event_frame

	vbox = {
		layoutpolicy_horizontal = expanding
		margin = { 10 8 }
		spacing = 8

		hbox = {
			layoutpolicy_horizontal = expanding
			spacing = 8

			text_single = {
				layoutpolicy_horizontal = expanding
				autoresize = no
				align = left|nobaseline
				default_format = "#bold"
				raw_text = "ModeU5 Stocks — inline Production body"
			}

			button_regular = {
				size = { 80 30 }
				raw_text = "Close"
				using = bg_button_flavor_4
				onclick = "[GetVariableSystem.Clear('modeu5_us10_stock_tab')]"
				tooltipwidget = { BasicFunctionalTooltip = {} }
			}
		}

		text_multi = {
			layoutpolicy_horizontal = expanding
			autoresize = yes
			raw_text = "Safe UI placeholder. This is not a custom lateralview and not a floating window. It is mounted inside the existing Production internal content flow."
		}

		text_multi = {
			layoutpolicy_horizontal = expanding
			autoresize = yes
			raw_text = "Next step after this is stable: add the market selector as a visual-only block, then reconnect stock rows and read-model refresh."
		}
	}
}
