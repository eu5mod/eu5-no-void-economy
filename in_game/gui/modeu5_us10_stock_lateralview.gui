template modeu5_us10_ui_stock_row {
	layoutpolicy_horizontal = expanding
	spacing = 4

	text_single = {
		size = { 94 20 }
		autoresize = no
		align = left|nobaseline
		default_format = "#high"
		block "good_text" { text = "" }
	}
	text_single = {
		size = { 70 20 }
		autoresize = no
		align = right|nobaseline
		block "produced_text" { text = "" }
	}
	text_single = {
		size = { 104 20 }
		autoresize = no
		align = right|nobaseline
		block "country_text" { text = "" }
	}
	text_single = {
		size = { 104 20 }
		autoresize = no
		align = right|nobaseline
		block "market_text" { text = "" }
	}
	text_single = {
		size = { 70 20 }
		autoresize = no
		align = right|nobaseline
		block "overproduction_text" { text = "" }
	}
}

window = {
	name = "modeu5_us10_stock"
	parentanchor = topleft
	widgetanchor = topleft
	position = { 0 102 }
	size = { 520 900 }
	alwaystransparent = yes

	vbox = {
		size = { 520 900 }
		using = bg_main_inner_alt
		using = bg_main_inner_image_alt
		blockoverride "image" {
			texture = "gfx/interface/illustrations/bg/bg_production.dds"
		}
		spacing = 8

		hbox = {
			layoutpolicy_horizontal = expanding
			margin = { 8 6 }
			spacing = 8

			text_single = {
				layoutpolicy_horizontal = expanding
				autoresize = no
				align = center|nobaseline
				default_format = "#bold"
				text = "modeu5_us10_ui.title"
			}

			button_close_alt = {
				blockoverride "close_onclick" {
					onclick = "[ExecuteConsoleCommand('GUI.ClearWidgets modeu5_us10_stock')]"
				}
			}
		}

		header_main_tabs = {
			blockoverride "content" {
				using = production_main_tabs
			}
		}

		overlappingitembox = {
			visible = no
			state = {
				name = modeu5_us10_ui_open_refresh
				trigger_on_create = yes
				duration = 1
				on_finish = "[GetScriptedGui('modeu5_us10_ui_refresh_on_click').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			}
		}

		vbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			margin = { 8 6 }
			spacing = 8

			text_multi = {
				layoutpolicy_horizontal = expanding
				autoresize = no
				size = { -1 42 }
				text = "modeu5_us10_ui.subtitle"
			}

			widget = {
				layoutpolicy_horizontal = expanding
				size = { -1 72 }
				using = bg_age_event_frame

				vbox = {
					layoutpolicy_horizontal = expanding
					margin = { 8 6 }
					spacing = 6

					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 6

						text_single = {
							layoutpolicy_horizontal = expanding
							autoresize = no
							align = left|nobaseline
							text = "modeu5_us10_ui.selected_market"
						}

						text_single = {
							size = { 90 22 }
							autoresize = no
							align = right|nobaseline
							text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_selected_market_index').GetValue|0]/[Player.MakeScope.GetVariable('modeu5_us10_ui_market_count').GetValue|0]"
						}
					}

					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 6

						button_regular = {
							size = { 122 28 }
							text = "modeu5_us10_ui.refresh"
							using = bg_button_flavor_4
							onclick = "[GetScriptedGui('modeu5_us10_ui_refresh_on_click').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						}

						button_regular = {
							size = { 142 28 }
							text = "modeu5_us10_ui.next_market"
							using = bg_button_flavor_4
							onclick = "[GetScriptedGui('modeu5_us10_ui_next_market_on_click').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						}
					}
				}
			}

			widget = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				using = bg_age_event_frame

				vbox = {
					layoutpolicy_horizontal = expanding
					margin = { 8 8 }
					spacing = 4

					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 4

						text_single = { size = { 94 24 } autoresize = no align = left|nobaseline default_format = "#bold" text = "modeu5_us10_ui.column.good" }
						text_single = { size = { 70 24 } autoresize = no align = right|nobaseline default_format = "#bold" text = "modeu5_us10_ui.column.produced" }
						text_single = { size = { 104 24 } autoresize = no align = right|nobaseline default_format = "#bold" text = "modeu5_us10_ui.column.country_stocks" }
						text_single = { size = { 104 24 } autoresize = no align = right|nobaseline default_format = "#bold" text = "modeu5_us10_ui.column.market_stocks" }
						text_single = { size = { 70 24 } autoresize = no align = right|nobaseline default_format = "#bold" text = "modeu5_us10_ui.column.overproduction" }
					}

					modeu5_us10_ui_stock_row = {
						blockoverride "good_text" { text = "modeu5_us10_ui.good.wheat" }
						blockoverride "produced_text" { text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_wheat_produced').GetValue|2]" }
						blockoverride "country_text" { text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_wheat_country_stock').GetValue|2]/[Player.MakeScope.GetVariable('modeu5_us10_ui_wheat_country_capacity').GetValue|2]" }
						blockoverride "market_text" { text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_wheat_market_stock').GetValue|2]/[Player.MakeScope.GetVariable('modeu5_us10_ui_wheat_market_capacity').GetValue|2]" }
						blockoverride "overproduction_text" { raw_text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_wheat_overproduction_percent').GetValue|2]%" }
					}
					modeu5_us10_ui_stock_row = {
						blockoverride "good_text" { text = "modeu5_us10_ui.good.iron" }
						blockoverride "produced_text" { text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_iron_produced').GetValue|2]" }
						blockoverride "country_text" { text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_iron_country_stock').GetValue|2]/[Player.MakeScope.GetVariable('modeu5_us10_ui_iron_country_capacity').GetValue|2]" }
						blockoverride "market_text" { text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_iron_market_stock').GetValue|2]/[Player.MakeScope.GetVariable('modeu5_us10_ui_iron_market_capacity').GetValue|2]" }
						blockoverride "overproduction_text" { raw_text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_iron_overproduction_percent').GetValue|2]%" }
					}
					modeu5_us10_ui_stock_row = {
						blockoverride "good_text" { text = "modeu5_us10_ui.good.tools" }
						blockoverride "produced_text" { text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_tools_produced').GetValue|2]" }
						blockoverride "country_text" { text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_tools_country_stock').GetValue|2]/[Player.MakeScope.GetVariable('modeu5_us10_ui_tools_country_capacity').GetValue|2]" }
						blockoverride "market_text" { text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_tools_market_stock').GetValue|2]/[Player.MakeScope.GetVariable('modeu5_us10_ui_tools_market_capacity').GetValue|2]" }
						blockoverride "overproduction_text" { raw_text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_tools_overproduction_percent').GetValue|2]%" }
					}
				}
			}

			text_multi = {
				layoutpolicy_horizontal = expanding
				autoresize = no
				size = { -1 58 }
				text = "modeu5_us10_ui.read_only_note"
			}
		}
	}
}
