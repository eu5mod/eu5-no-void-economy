# ModeU5 US-10 stock panel.
# Registered through gui/scripted_widgets/modeu5_us10_stock.txt.
# Important: scripted_widgets expects a widget named modeu5_us10_stock in this file.

template modeu5_us10_ui_panel_header_cell {
	layoutpolicy_horizontal = expanding
	layoutstretchfactor_horizontal = 1
	autoresize = no
	align = left|nobaseline
	default_format = "#bold"
	block "text" { text = "" }
}

template modeu5_us10_ui_panel_value_cell {
	layoutpolicy_horizontal = expanding
	layoutstretchfactor_horizontal = 1
	autoresize = no
	align = left|nobaseline
	block "text" { text = "" }
}

widget = {
	name = "modeu5_us10_stock"
	size = { 100% 100% }
	alwaystransparent = yes
	ignoreinvisible = yes

	button_regular = {
		visible = "[IsLateralViewOpened('production')]"
		parentanchor = top|right
		widgetanchor = top|right
		position = { -20 140 }
		size = { 150 34 }
		text = "modeu5_us10_ui.tab"
		using = bg_button_flavor_4
		onclick = "[GetVariableSystem.Toggle('modeu5_us10_stock_tab')]"
		onclick = "[GetScriptedGui('modeu5_us10_ui_refresh_on_click').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		tooltipwidget = { BasicFunctionalTooltip = {} }
	}

	window = {
		visible = "[GetVariableSystem.Exists('modeu5_us10_stock_tab')]"
		parentanchor = center
		widgetanchor = center
		size = { 980 610 }
		using = bg_window_default_alt
		movable = yes
		alwaystransparent = no

		vbox = {
			margin = { 14 12 }
			spacing = 10

			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 8
				text_single = {
					layoutpolicy_horizontal = expanding
					text = "modeu5_us10_ui.title"
					default_format = "#title"
				}
				button_regular = {
					size = { 80 30 }
					raw_text = "Close"
					using = bg_button_flavor_4
					onclick = "[GetVariableSystem.Clear('modeu5_us10_stock_tab')]"
					tooltipwidget = { BasicFunctionalTooltip = {} }
				}
			}

			text_single = {
				layoutpolicy_horizontal = expanding
				autoresize = no
				align = left|nobaseline
				default_format = "#bold"
				raw_text = "Market selector"
			}

			scrollbox = {
				layoutpolicy_horizontal = expanding
				size = { -1 180 }
				datacontext = "[GetQuickVisibleMarkets(GetPlayer)]"

				dynamicgridbox = {
					layoutpolicy_horizontal = expanding
					datamodel = "[QuickVisibleMarkets.GetVisibleMarkets]"
					datamodel_reuse_widgets = yes

					item = {
						widget = {
							size = { 300 74 }
							margin = { 4 4 }
							visible = "[GreaterThan_CFixedPoint(Market.GetCountryPopulation(GetPlayer),'(CFixedPoint)0')]"
							using = bg_market_card
							using = bg_cabinet_card_frame

							button = {
								size = { 100% 100% }
								alwaystransparent = yes
								onclick = "[SetUIFocusMarket(Market.Self)]"
								onclick = "[GetScriptedGui('modeu5_us10_ui_select_market_on_click').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('modeu5_us10_ui_clicked_market', Market.MakeScope).End)]"
								tooltipwidget = { using = Market_tooltip }
							}

							market_card = {
								blockoverride "market_card_margins" {
									margin = { 5 5 }
								}
							}
						}
					}
				}
			}

			widget = {
				layoutpolicy_horizontal = expanding
				size = { -1 38 }
				using = bg_age_event_frame
				hbox = {
					layoutpolicy_horizontal = expanding
					margin = { 10 6 }
					spacing = 8
					text_single = {
						layoutpolicy_horizontal = expanding
						autoresize = no
						align = left|nobaseline
						text = "modeu5_us10_ui.selected_market"
					}
					text_single = {
						layoutpolicy_horizontal = expanding
						autoresize = no
						align = right|nobaseline
						text = "[GetPlayer.MakeScope.GetVariable('modeu5_us10_ui_selected_market_index').GetValue|0]/[GetPlayer.MakeScope.GetVariable('modeu5_us10_ui_market_count').GetValue|0]"
					}
				}
			}

			widget = {
				layoutpolicy_horizontal = expanding
				using = bg_age_event_frame
				vbox = {
					layoutpolicy_horizontal = expanding
					margin = { 10 8 }
					spacing = 8
					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 8
						text_single = { using = modeu5_us10_ui_panel_header_cell blockoverride "text" { text = "modeu5_us10_ui.column.good" } }
						text_single = { using = modeu5_us10_ui_panel_header_cell blockoverride "text" { text = "modeu5_us10_ui.column.country_stocks" } }
						text_single = { using = modeu5_us10_ui_panel_header_cell blockoverride "text" { text = "modeu5_us10_ui.column.market_stocks" } }
						text_single = { using = modeu5_us10_ui_panel_header_cell blockoverride "text" { text = "modeu5_us10_ui.column.overproduction" } }
					}

					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 8
						text_single = { using = modeu5_us10_ui_panel_value_cell blockoverride "text" { text = "modeu5_us10_ui.good.wheat" } }
						text_single = { using = modeu5_us10_ui_panel_value_cell blockoverride "text" { text = "[GetPlayer.MakeScope.GetVariable('modeu5_us10_ui_wheat_country_stock').GetValue|2]/[GetPlayer.MakeScope.GetVariable('modeu5_us10_ui_wheat_country_capacity').GetValue|2]" } }
						text_single = { using = modeu5_us10_ui_panel_value_cell blockoverride "text" { text = "[GetPlayer.MakeScope.GetVariable('modeu5_us10_ui_wheat_market_stock').GetValue|2]/[GetPlayer.MakeScope.GetVariable('modeu5_us10_ui_wheat_market_capacity').GetValue|2]" } }
						text_single = { using = modeu5_us10_ui_panel_value_cell blockoverride "text" { raw_text = "[GetPlayer.MakeScope.GetVariable('modeu5_us10_ui_wheat_overproduction_percent').GetValue|2]%" } }
					}

					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 8
						text_single = { using = modeu5_us10_ui_panel_value_cell blockoverride "text" { text = "modeu5_us10_ui.good.iron" } }
						text_single = { using = modeu5_us10_ui_panel_value_cell blockoverride "text" { text = "[GetPlayer.MakeScope.GetVariable('modeu5_us10_ui_iron_country_stock').GetValue|2]/[GetPlayer.MakeScope.GetVariable('modeu5_us10_ui_iron_country_capacity').GetValue|2]" } }
						text_single = { using = modeu5_us10_ui_panel_value_cell blockoverride "text" { text = "[GetPlayer.MakeScope.GetVariable('modeu5_us10_ui_iron_market_stock').GetValue|2]/[GetPlayer.MakeScope.GetVariable('modeu5_us10_ui_iron_market_capacity').GetValue|2]" } }
						text_single = { using = modeu5_us10_ui_panel_value_cell blockoverride "text" { raw_text = "[GetPlayer.MakeScope.GetVariable('modeu5_us10_ui_iron_overproduction_percent').GetValue|2]%" } }
					}

					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 8
						text_single = { using = modeu5_us10_ui_panel_value_cell blockoverride "text" { text = "modeu5_us10_ui.good.tools" } }
						text_single = { using = modeu5_us10_ui_panel_value_cell blockoverride "text" { text = "[GetPlayer.MakeScope.GetVariable('modeu5_us10_ui_tools_country_stock').GetValue|2]/[GetPlayer.MakeScope.GetVariable('modeu5_us10_ui_tools_country_capacity').GetValue|2]" } }
						text_single = { using = modeu5_us10_ui_panel_value_cell blockoverride "text" { text = "[GetPlayer.MakeScope.GetVariable('modeu5_us10_ui_tools_market_stock').GetValue|2]/[GetPlayer.MakeScope.GetVariable('modeu5_us10_ui_tools_market_capacity').GetValue|2]" } }
						text_single = { using = modeu5_us10_ui_panel_value_cell blockoverride "text" { raw_text = "[GetPlayer.MakeScope.GetVariable('modeu5_us10_ui_tools_overproduction_percent').GetValue|2]%" } }
					}
				}
			}

			text_multi = {
				layoutpolicy_horizontal = expanding
				autoresize = yes
				text = "modeu5_us10_ui.read_only_note"
			}
		}
	}
}
