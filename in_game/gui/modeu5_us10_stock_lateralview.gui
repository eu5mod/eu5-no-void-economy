# ModeU5 US-10 stock panel shell.
#
# Plan A mounts this shell inside Production through
# zz_modeu5_us10_production_subtabs.gui. The stock table itself lives in
# modeu5_us10_stock_table.gui so it can be reused unchanged by Plan B if needed.

template modeu5_us10_stock_panel {
	visible = "[GetVariableSystem.Exists('modeu5_us10_stock_tab')]"
	layoutpolicy_horizontal = expanding
	layoutpolicy_vertical = expanding
	size = { -1 940 }
	using = bg_age_event_frame
	# Best-effort Plan A auto-sync: when the player returns the cursor anywhere
	# inside the ModeU5 body after changing the vanilla Production market, refresh
	# the read-model from ProductionView.GetSelectedMarket. A true click-time sync
	# would require patching the original production selector inside the vanilla
	# lateralview body.
	onmousehierarchyenter = "[GetScriptedGui('modeu5_us10_ui_select_market_on_click').Execute(GuiScope.SetRoot(Player.MakeScope).AddScope('modeu5_us10_ui_clicked_market', ProductionView.GetSelectedMarket.MakeScope).End)]"

	vbox = {
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding
		margin = { 10 8 }
		spacing = 8

		hbox = {
			layoutpolicy_horizontal = expanding
			spacing = 8

			text_single = {
				layoutpolicy_horizontal = expanding
				autoresize = no
				align = left|nobaseline
				default_format = "#bold"
				raw_text = "ModeU5 Country Stocks"
			}

			button_regular = {
				size = { 80 30 }
				raw_text = "Close"
				using = bg_button_flavor_4
				onclick = "[GetVariableSystem.Clear('modeu5_us10_stock_tab')]"
				tooltipwidget = { BasicFunctionalTooltip = {} }
			}
		}

		widget = {
			layoutpolicy_horizontal = expanding
			size = { -1 44 }
			using = bg_window_default_alt
			datacontext = "[ProductionView.GetSelectedMarket]"
			onmousehierarchyenter = "[GetScriptedGui('modeu5_us10_ui_select_market_on_click').Execute(GuiScope.SetRoot(Player.MakeScope).AddScope('modeu5_us10_ui_clicked_market', Market.MakeScope).End)]"

			hbox = {
				layoutpolicy_horizontal = expanding
				margin = { 10 7 }
				spacing = 10

				text_single = {
					layoutpolicy_horizontal = expanding
					autoresize = no
					align = left|nobaseline
					default_format = "#bold"
					raw_text = "Selected market"
				}

				text_single = {
					layoutpolicy_horizontal = expanding
					autoresize = no
					align = right|nobaseline
					text = "[Market.GetName]"
				}

				button_regular = {
					size = { 90 28 }
					raw_text = "Sync"
					using = bg_button_flavor_4
					onclick = "[GetScriptedGui('modeu5_us10_ui_select_market_on_click').Execute(GuiScope.SetRoot(Player.MakeScope).AddScope('modeu5_us10_ui_clicked_market', Market.MakeScope).End)]"
					tooltipwidget = { BasicFunctionalTooltip = {} }
				}
			}
		}

		widget = {
			using = modeu5_us10_stock_table
		}
	}
}
