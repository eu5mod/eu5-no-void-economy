template production_main_tabs {
	button_main_tab_alt = {
		using = layoutpolicy_expanding
		tooltipwidget = {
			using = TabBuildingsTooltip
		}
		widget = {
			visible = "[Not(IsLateralViewOpened('production'))]"
			size = { 100% 100% }
			name = "tab_buildings"
		}
		down = "[IsLateralViewOpened('production')]"
		datacontext = "[GetAutomatedSystemItem4('buildings', 'productionmethods', 'closebuildings', 'subsidizebuildings')]"
		using = multi_automated_tab

		blockoverride "on_action_left" { on_action = "[OpenLateralView('production')]" }
		blockoverride "on_action_right_title" { title = "TOGGLE_PRODUCTION_AUTOMATION" }
		blockoverride "text" { text = "PRODUCTION_TEXT" }
	}

	button_main_tab_alt = {
		using = layoutpolicy_expanding
		tooltipwidget = {
			using = TabGoodsTooltip
		}

		down = "[IsLateralViewOpened('goods_production')]"
		datacontext = "[GetAutomatedSystemItem('rgo')]"
		using = automated_tab

		blockoverride "on_action_left" { on_action = "[OpenLateralView('goods_production')]" }
		blockoverride "text" { text = "EXPAND_RAW_GOODS_TEXT" }
	}

	button_main_tab_alt = {
		using = layoutpolicy_expanding
		blockoverride "tab_text" {
			text = "FOOD_PRODUCTION_TEXT"
		}
		onclick = "[OpenLateralView('food_production')]"
		down = "[IsLateralViewOpened('food_production')]"
		tooltipwidget = {
			using = TabFoodTooltip
		}
	}

	button_main_tab_alt = {
		using = layoutpolicy_expanding
		blockoverride "tab_text" {
			text = "game_concept_locations"
		}
		onclick = "[OpenLateralView('town_rights')]"
		down = "[IsLateralViewOpened('town_rights')]"
		tooltipwidget = {
			using = TabTownRightsTooltip
		}
	}

	button_main_tab_alt = {
		using = layoutpolicy_expanding
		blockoverride "tab_text" {
			text = "modeu5_us10_ui.tab"
		}
		onclick = "[OpenLateralView('modeu5_us10_stock')]"
		down = "[IsLateralViewOpened('modeu5_us10_stock')]"
		tooltipwidget = {
			BasicFunctionalTooltip = {}
		}
	}
}

template modeu5_us10_ui_header_cell {
	text_single = {
		layoutpolicy_horizontal = expanding
		layoutstretchfactor_horizontal = 1
		autoresize = no
		align = left|nobaseline
		default_format = "#bold"
		block "text" {
			text = ""
		}
	}
}

template modeu5_us10_ui_value_cell {
	text_single = {
		layoutpolicy_horizontal = expanding
		layoutstretchfactor_horizontal = 1
		autoresize = no
		align = left|nobaseline
		block "text" {
			text = ""
		}
	}
}

template modeu5_us10_ui_good_cell {
	text_single = {
		layoutpolicy_horizontal = expanding
		layoutstretchfactor_horizontal = 1
		autoresize = no
		align = left|nobaseline
		default_format = "#high"
		block "text" {
			text = ""
		}
	}
}

lateralview = {
	name = "modeu5_us10_stock_lateralview"
	widgetid = "modeu5_us10_stock_lateralview"

	blockoverride "panel_header" {
		window_header_alt = {
			blockoverride "header_text" {
				text = "modeu5_us10_ui.title"
			}
			blockoverride "window_header_alt_color_texture" {
				using = color_production_texture
			}
		}
	}

	blockoverride "panel_content" {
		header_main_tabs = {
			blockoverride "content" {
				using = production_main_tabs
			}
		}

		widget = {
			using = layoutpolicy_expanding

			vbox = {
				using = bg_main_inner_alt
				using = bg_main_inner_image_alt
				blockoverride "image" {
					texture = "gfx/interface/illustrations/bg/bg_production.dds"
				}
				using = window_main_tabs_margin_alt
				spacing = 10

				overlappingitembox = {
					visible = no
					state = {
						name = modeu5_us10_ui_open_refresh
						trigger_on_create = yes
						duration = 1
						on_finish = "[GetScriptedGui('modeu5_us10_ui_refresh_on_click').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					}
				}

				hbox = {
					layoutpolicy_horizontal = expanding
					spacing = 8

					text_single = {
						layoutpolicy_horizontal = expanding
						autoresize = no
						align = left|nobaseline
						text = "modeu5_us10_ui.subtitle"
					}

					button_regular = {
						size = { 130 34 }
						text = "modeu5_us10_ui.refresh"
						using = bg_button_flavor_4
						tooltipwidget = {
							BasicFunctionalTooltip = {}
						}
						action_tooltip = {
							title = "modeu5_us10_ui.refresh.tooltip"
							on_action = "[GetScriptedGui('modeu5_us10_ui_refresh_on_click').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						}
					}

					button_regular = {
						size = { 150 34 }
						text = "modeu5_us10_ui.next_market"
						using = bg_button_flavor_4
						tooltipwidget = {
							BasicFunctionalTooltip = {}
						}
						action_tooltip = {
							title = "modeu5_us10_ui.next_market.tooltip"
							on_action = "[GetScriptedGui('modeu5_us10_ui_next_market_on_click').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						}
					}
				}

				widget = {
					layoutpolicy_horizontal = expanding
					size = { -1 38 }
					using = bg_age_event_frame

					hbox = {
						layoutpolicy_horizontal = expanding
						margin = { 10 6 }
						spacing = 8

						text_single = {
							layoutpolicy_horizontal = expanding
							autoresize = no
							align = left|nobaseline
							text = "modeu5_us10_ui.selected_market"
						}

						text_single = {
							layoutpolicy_horizontal = expanding
							autoresize = no
							align = right|nobaseline
							text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_selected_market_index').GetValue|0]/[Player.MakeScope.GetVariable('modeu5_us10_ui_market_count').GetValue|0]"
						}
					}
				}

				widget = {
					layoutpolicy_horizontal = expanding
					using = bg_age_event_frame

					vbox = {
						layoutpolicy_horizontal = expanding
						margin = { 10 8 }
						spacing = 8

						hbox = {
							layoutpolicy_horizontal = expanding
							spacing = 8

							modeu5_us10_ui_header_cell = {
								blockoverride "text" { text = "modeu5_us10_ui.column.good" }
							}
							modeu5_us10_ui_header_cell = {
								blockoverride "text" { text = "modeu5_us10_ui.column.country_stocks" }
							}
							modeu5_us10_ui_header_cell = {
								blockoverride "text" { text = "modeu5_us10_ui.column.market_stocks" }
							}
							modeu5_us10_ui_header_cell = {
								blockoverride "text" { text = "modeu5_us10_ui.column.overproduction" }
							}
							modeu5_us10_ui_header_cell = {
								blockoverride "text" { text = "modeu5_us10_ui.column.production_efficiency" }
							}
						}

						hbox = {
							layoutpolicy_horizontal = expanding
							spacing = 8

							modeu5_us10_ui_good_cell = {
								blockoverride "text" { text = "modeu5_us10_ui.good.wheat" }
							}
							modeu5_us10_ui_value_cell = {
								blockoverride "text" { text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_wheat_country_stock').GetValue|2]/[Player.MakeScope.GetVariable('modeu5_us10_ui_wheat_country_capacity').GetValue|2]" }
							}
							modeu5_us10_ui_value_cell = {
								blockoverride "text" { text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_wheat_market_stock').GetValue|2]/[Player.MakeScope.GetVariable('modeu5_us10_ui_wheat_market_capacity').GetValue|2]" }
							}
							modeu5_us10_ui_value_cell = {
								blockoverride "text" { text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_wheat_overproduction_percent').GetValue|2]%" }
							}
							modeu5_us10_ui_value_cell = {
								blockoverride "text" { text = "modeu5_us10_ui.not_available" }
							}
						}

						hbox = {
							layoutpolicy_horizontal = expanding
							spacing = 8

							modeu5_us10_ui_good_cell = {
								blockoverride "text" { text = "modeu5_us10_ui.good.iron" }
							}
							modeu5_us10_ui_value_cell = {
								blockoverride "text" { text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_iron_country_stock').GetValue|2]/[Player.MakeScope.GetVariable('modeu5_us10_ui_iron_country_capacity').GetValue|2]" }
							}
							modeu5_us10_ui_value_cell = {
								blockoverride "text" { text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_iron_market_stock').GetValue|2]/[Player.MakeScope.GetVariable('modeu5_us10_ui_iron_market_capacity').GetValue|2]" }
							}
							modeu5_us10_ui_value_cell = {
								blockoverride "text" { text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_iron_overproduction_percent').GetValue|2]%" }
							}
							modeu5_us10_ui_value_cell = {
								blockoverride "text" { text = "modeu5_us10_ui.not_available" }
							}
						}

						hbox = {
							layoutpolicy_horizontal = expanding
							spacing = 8

							modeu5_us10_ui_good_cell = {
								blockoverride "text" { text = "modeu5_us10_ui.good.tools" }
							}
							modeu5_us10_ui_value_cell = {
								blockoverride "text" { text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_tools_country_stock').GetValue|2]/[Player.MakeScope.GetVariable('modeu5_us10_ui_tools_country_capacity').GetValue|2]" }
							}
							modeu5_us10_ui_value_cell = {
								blockoverride "text" { text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_tools_market_stock').GetValue|2]/[Player.MakeScope.GetVariable('modeu5_us10_ui_tools_market_capacity').GetValue|2]" }
							}
							modeu5_us10_ui_value_cell = {
								blockoverride "text" { text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_tools_overproduction_percent').GetValue|2]%" }
							}
							modeu5_us10_ui_value_cell = {
								blockoverride "text" { text = "modeu5_us10_ui.not_available" }
							}
						}
					}
				}

				text_multi = {
					layoutpolicy_horizontal = expanding
					autoresize = no
					text = "modeu5_us10_ui.read_only_note"
				}
			}
		}
	}
}
