# US-10 minimal Production UI injection.
#
# Custom lateralviews are not registered through OpenLateralView. This file only
# overrides the existing production tab template, adds a ModeU5 tab button, and
# instantiates the ModeU5 panel template in the already-loaded Production UI.

template production_main_tabs {
	button_main_tab_alt = {
		using = layoutpolicy_expanding
		tooltipwidget = {
			using = TabBuildingsTooltip
		}
		widget = {
			visible = "[Not(IsLateralViewOpened('production'))]"
			size = { 100% 100% }
			name = "tab_buildings"
		}
		down = "[And(IsLateralViewOpened('production'), Not(GetVariableSystem.Exists('modeu5_us10_stock_tab')))]"
		datacontext = "[GetAutomatedSystemItem4('buildings', 'productionmethods', 'closebuildings', 'subsidizebuildings')]"
		using = multi_automated_tab

		blockoverride "on_action_left" {
			on_action = "[GetVariableSystem.Clear('modeu5_us10_stock_tab')]"
			on_action = "[OpenLateralView('production')]"
		}
		blockoverride "on_action_right_title" { title = "TOGGLE_PRODUCTION_AUTOMATION" }
		blockoverride "text" { text = "PRODUCTION_TEXT" }
	}

	button_main_tab_alt = {
		using = layoutpolicy_expanding
		tooltipwidget = {
			using = TabGoodsTooltip
		}

		down = "[IsLateralViewOpened('goods_production')]"
		datacontext = "[GetAutomatedSystemItem('rgo')]"
		using = automated_tab

		blockoverride "on_action_left" {
			on_action = "[GetVariableSystem.Clear('modeu5_us10_stock_tab')]"
			on_action = "[OpenLateralView('goods_production')]"
		}
		blockoverride "text" { text = "EXPAND_RAW_GOODS_TEXT" }
	}

	button_main_tab_alt = {
		using = layoutpolicy_expanding
		blockoverride "tab_text" {
			text = "FOOD_PRODUCTION_TEXT"
		}
		onclick = "[GetVariableSystem.Clear('modeu5_us10_stock_tab')]"
		onclick = "[OpenLateralView('food_production')]"
		down = "[IsLateralViewOpened('food_production')]"
		tooltipwidget = {
			using = TabFoodTooltip
		}
	}

	button_main_tab_alt = {
		using = layoutpolicy_expanding
		blockoverride "tab_text" {
			text = "game_concept_locations"
		}
		onclick = "[GetVariableSystem.Clear('modeu5_us10_stock_tab')]"
		onclick = "[OpenLateralView('town_rights')]"
		down = "[IsLateralViewOpened('town_rights')]"
		tooltipwidget = {
			using = TabTownRightsTooltip
		}
	}

	button_main_tab_alt = {
		using = layoutpolicy_expanding
		blockoverride "tab_text" {
			text = "modeu5_us10_ui.tab"
		}
		# Keep ModeU5 as a sub-mode of the existing production lateralview.
		# Do not call the heavy US-10 refresh/read-model from this tab.
		onclick = "[OpenLateralView('production')]"
		onclick = "[GetVariableSystem.Set('modeu5_us10_stock_tab', 'yes')]"
		down = "[And(IsLateralViewOpened('production'), GetVariableSystem.Exists('modeu5_us10_stock_tab'))]"
		tooltipwidget = {
			BasicFunctionalTooltip = {}
		}
	}

	widget = {
		visible = "[And(IsLateralViewOpened('production'), GetVariableSystem.Exists('modeu5_us10_stock_tab'))]"
		allow_outside = yes
		using = modeu5_us10_stock_panel
	}
}
