# ModeU5 US-10 reusable stock table templates.
#
# Kept separate from the Plan A mounting point so the table can be reused if
# Plan B later generates a full production_lateralview.gui override.
#
# US-10 spec columns:
# Good | Country Stocks | Market Stocks | Overproduction | Production Efficiency
#
# V0 intentionally keeps a compact stock-bearing row set to avoid making
# Loading Game resources heavier while the UI mounting/sync path is still being
# stabilised. Full all-goods row generation belongs in Plan B or in a dynamic
# datamodel implementation.

template modeu5_us10_stock_header_cell_left {
	layoutpolicy_horizontal = expanding
	layoutstretchfactor_horizontal = 1
	autoresize = no
	align = left|nobaseline
	fontsize = 12
	default_format = "#bold"
	block "text" { raw_text = "" }
}

template modeu5_us10_stock_header_cell_right {
	layoutpolicy_horizontal = expanding
	layoutstretchfactor_horizontal = 1
	autoresize = no
	align = right|nobaseline
	fontsize = 12
	default_format = "#bold"
	block "text" { raw_text = "" }
}

template modeu5_us10_stock_value_cell_left {
	layoutpolicy_horizontal = expanding
	layoutstretchfactor_horizontal = 1
	autoresize = no
	align = left|nobaseline
	fontsize = 13
	block "text" { raw_text = "" }
}

template modeu5_us10_stock_value_cell_right {
	layoutpolicy_horizontal = expanding
	layoutstretchfactor_horizontal = 1
	autoresize = no
	align = right|nobaseline
	fontsize = 13
	block "text" { raw_text = "" }
}

template modeu5_us10_stock_row {
	layoutpolicy_horizontal = expanding
	spacing = 8
	block "good" { text_single = { using = modeu5_us10_stock_value_cell_left } }
	block "country_stocks" { text_single = { using = modeu5_us10_stock_value_cell_right } }
	block "market_stocks" { text_single = { using = modeu5_us10_stock_value_cell_right } }
	block "overproduction" { text_single = { using = modeu5_us10_stock_value_cell_right } }
	block "production_efficiency" { text_single = { using = modeu5_us10_stock_value_cell_right } }
}

template modeu5_us10_stock_table {
	layoutpolicy_horizontal = expanding
	layoutpolicy_vertical = expanding
	using = bg_window_default_alt

	vbox = {
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding
		margin = { 10 8 }
		spacing = 7

		hbox = {
			layoutpolicy_horizontal = expanding
			spacing = 8
			text_single = { using = modeu5_us10_stock_header_cell_left blockoverride "text" { raw_text = "Good" } }
			text_single = { using = modeu5_us10_stock_header_cell_right blockoverride "text" { raw_text = "Country Stocks" } }
			text_single = { using = modeu5_us10_stock_header_cell_right blockoverride "text" { raw_text = "Market Stocks" } }
			text_single = { using = modeu5_us10_stock_header_cell_right blockoverride "text" { raw_text = "Overproduction" } }
			text_single = { using = modeu5_us10_stock_header_cell_right blockoverride "text" { raw_text = "Production Efficiency" } }
		}

		scrollarea = {
			using = layoutpolicy_expanding
			scrollbarpolicy_horizontal = always_off
			autoresizescrollarea = no

			scrollbar_vertical = {
				using = Scrollbar_Vertical
			}

			scrollwidget = {
				vbox = {
					layoutpolicy_horizontal = expanding
					spacing = 5

					hbox = { using = modeu5_us10_stock_row visible = "[Or3(GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('modeu5_us10_ui_cotton_country_stock').GetValue, '(CFixedPoint)0'), GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('modeu5_us10_ui_cotton_market_stock').GetValue, '(CFixedPoint)0'), GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('modeu5_us10_ui_cotton_overproduction_percent').GetValue, '(CFixedPoint)0'))]" blockoverride "good" { text_single = { using = modeu5_us10_stock_value_cell_left blockoverride "text" { raw_text = "Cotton" } } } blockoverride "country_stocks" { text_single = { using = modeu5_us10_stock_value_cell_right blockoverride "text" { text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_cotton_country_stock').GetValue|2]/[Player.MakeScope.GetVariable('modeu5_us10_ui_cotton_country_capacity').GetValue|2]" } } } blockoverride "market_stocks" { text_single = { using = modeu5_us10_stock_value_cell_right blockoverride "text" { text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_cotton_market_stock').GetValue|2]/[Player.MakeScope.GetVariable('modeu5_us10_ui_cotton_market_capacity').GetValue|2]" } } } blockoverride "overproduction" { text_single = { using = modeu5_us10_stock_value_cell_right blockoverride "text" { text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_cotton_overproduction_percent').GetValue|2]%" } } } blockoverride "production_efficiency" { text_single = { using = modeu5_us10_stock_value_cell_right blockoverride "text" { raw_text = "n/a" } } } }
					hbox = { using = modeu5_us10_stock_row visible = "[Or3(GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('modeu5_us10_ui_sugar_country_stock').GetValue, '(CFixedPoint)0'), GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('modeu5_us10_ui_sugar_market_stock').GetValue, '(CFixedPoint)0'), GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('modeu5_us10_ui_sugar_overproduction_percent').GetValue, '(CFixedPoint)0'))]" blockoverride "good" { text_single = { using = modeu5_us10_stock_value_cell_left blockoverride "text" { raw_text = "Sugar" } } } blockoverride "country_stocks" { text_single = { using = modeu5_us10_stock_value_cell_right blockoverride "text" { text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_sugar_country_stock').GetValue|2]/[Player.MakeScope.GetVariable('modeu5_us10_ui_sugar_country_capacity').GetValue|2]" } } } blockoverride "market_stocks" { text_single = { using = modeu5_us10_stock_value_cell_right blockoverride "text" { text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_sugar_market_stock').GetValue|2]/[Player.MakeScope.GetVariable('modeu5_us10_ui_sugar_market_capacity').GetValue|2]" } } } blockoverride "overproduction" { text_single = { using = modeu5_us10_stock_value_cell_right blockoverride "text" { text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_sugar_overproduction_percent').GetValue|2]%" } } } blockoverride "production_efficiency" { text_single = { using = modeu5_us10_stock_value_cell_right blockoverride "text" { raw_text = "n/a" } } } }
					hbox = { using = modeu5_us10_stock_row visible = "[Or3(GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('modeu5_us10_ui_tobacco_country_stock').GetValue, '(CFixedPoint)0'), GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('modeu5_us10_ui_tobacco_market_stock').GetValue, '(CFixedPoint)0'), GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('modeu5_us10_ui_tobacco_overproduction_percent').GetValue, '(CFixedPoint)0'))]" blockoverride "good" { text_single = { using = modeu5_us10_stock_value_cell_left blockoverride "text" { raw_text = "Tobacco" } } } blockoverride "country_stocks" { text_single = { using = modeu5_us10_stock_value_cell_right blockoverride "text" { text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_tobacco_country_stock').GetValue|2]/[Player.MakeScope.GetVariable('modeu5_us10_ui_tobacco_country_capacity').GetValue|2]" } } } blockoverride "market_stocks" { text_single = { using = modeu5_us10_stock_value_cell_right blockoverride "text" { text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_tobacco_market_stock').GetValue|2]/[Player.MakeScope.GetVariable('modeu5_us10_ui_tobacco_market_capacity').GetValue|2]" } } } blockoverride "overproduction" { text_single = { using = modeu5_us10_stock_value_cell_right blockoverride "text" { text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_tobacco_overproduction_percent').GetValue|2]%" } } } blockoverride "production_efficiency" { text_single = { using = modeu5_us10_stock_value_cell_right blockoverride "text" { raw_text = "n/a" } } } }
					hbox = { using = modeu5_us10_stock_row visible = "[Or3(GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('modeu5_us10_ui_tar_country_stock').GetValue, '(CFixedPoint)0'), GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('modeu5_us10_ui_tar_market_stock').GetValue, '(CFixedPoint)0'), GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('modeu5_us10_ui_tar_overproduction_percent').GetValue, '(CFixedPoint)0'))]" blockoverride "good" { text_single = { using = modeu5_us10_stock_value_cell_left blockoverride "text" { raw_text = "Tar" } } } blockoverride "country_stocks" { text_single = { using = modeu5_us10_stock_value_cell_right blockoverride "text" { text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_tar_country_stock').GetValue|2]/[Player.MakeScope.GetVariable('modeu5_us10_ui_tar_country_capacity').GetValue|2]" } } } blockoverride "market_stocks" { text_single = { using = modeu5_us10_stock_value_cell_right blockoverride "text" { text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_tar_market_stock').GetValue|2]/[Player.MakeScope.GetVariable('modeu5_us10_ui_tar_market_capacity').GetValue|2]" } } } blockoverride "overproduction" { text_single = { using = modeu5_us10_stock_value_cell_right blockoverride "text" { text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_tar_overproduction_percent').GetValue|2]%" } } } blockoverride "production_efficiency" { text_single = { using = modeu5_us10_stock_value_cell_right blockoverride "text" { raw_text = "n/a" } } } }
					hbox = { using = modeu5_us10_stock_row visible = "[Or3(GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('modeu5_us10_ui_porcelain_country_stock').GetValue, '(CFixedPoint)0'), GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('modeu5_us10_ui_porcelain_market_stock').GetValue, '(CFixedPoint)0'), GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('modeu5_us10_ui_porcelain_overproduction_percent').GetValue, '(CFixedPoint)0'))]" blockoverride "good" { text_single = { using = modeu5_us10_stock_value_cell_left blockoverride "text" { raw_text = "Porcelain" } } } blockoverride "country_stocks" { text_single = { using = modeu5_us10_stock_value_cell_right blockoverride "text" { text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_porcelain_country_stock').GetValue|2]/[Player.MakeScope.GetVariable('modeu5_us10_ui_porcelain_country_capacity').GetValue|2]" } } } blockoverride "market_stocks" { text_single = { using = modeu5_us10_stock_value_cell_right blockoverride "text" { text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_porcelain_market_stock').GetValue|2]/[Player.MakeScope.GetVariable('modeu5_us10_ui_porcelain_market_capacity').GetValue|2]" } } } blockoverride "overproduction" { text_single = { using = modeu5_us10_stock_value_cell_right blockoverride "text" { text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_porcelain_overproduction_percent').GetValue|2]%" } } } blockoverride "production_efficiency" { text_single = { using = modeu5_us10_stock_value_cell_right blockoverride "text" { raw_text = "n/a" } } } }
					hbox = { using = modeu5_us10_stock_row visible = "[Or3(GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('modeu5_us10_ui_naval_supplies_country_stock').GetValue, '(CFixedPoint)0'), GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('modeu5_us10_ui_naval_supplies_market_stock').GetValue, '(CFixedPoint)0'), GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('modeu5_us10_ui_naval_supplies_overproduction_percent').GetValue, '(CFixedPoint)0'))]" blockoverride "good" { text_single = { using = modeu5_us10_stock_value_cell_left blockoverride "text" { raw_text = "Naval supplies" } } } blockoverride "country_stocks" { text_single = { using = modeu5_us10_stock_value_cell_right blockoverride "text" { text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_naval_supplies_country_stock').GetValue|2]/[Player.MakeScope.GetVariable('modeu5_us10_ui_naval_supplies_country_capacity').GetValue|2]" } } } blockoverride "market_stocks" { text_single = { using = modeu5_us10_stock_value_cell_right blockoverride "text" { text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_naval_supplies_market_stock').GetValue|2]/[Player.MakeScope.GetVariable('modeu5_us10_ui_naval_supplies_market_capacity').GetValue|2]" } } } blockoverride "overproduction" { text_single = { using = modeu5_us10_stock_value_cell_right blockoverride "text" { text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_naval_supplies_overproduction_percent').GetValue|2]%" } } } blockoverride "production_efficiency" { text_single = { using = modeu5_us10_stock_value_cell_right blockoverride "text" { raw_text = "n/a" } } } }
					hbox = { using = modeu5_us10_stock_row visible = "[Or3(GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('modeu5_us10_ui_wheat_country_stock').GetValue, '(CFixedPoint)0'), GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('modeu5_us10_ui_wheat_market_stock').GetValue, '(CFixedPoint)0'), GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('modeu5_us10_ui_wheat_overproduction_percent').GetValue, '(CFixedPoint)0'))]" blockoverride "good" { text_single = { using = modeu5_us10_stock_value_cell_left blockoverride "text" { raw_text = "Wheat" } } } blockoverride "country_stocks" { text_single = { using = modeu5_us10_stock_value_cell_right blockoverride "text" { text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_wheat_country_stock').GetValue|2]/[Player.MakeScope.GetVariable('modeu5_us10_ui_wheat_country_capacity').GetValue|2]" } } } blockoverride "market_stocks" { text_single = { using = modeu5_us10_stock_value_cell_right blockoverride "text" { text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_wheat_market_stock').GetValue|2]/[Player.MakeScope.GetVariable('modeu5_us10_ui_wheat_market_capacity').GetValue|2]" } } } blockoverride "overproduction" { text_single = { using = modeu5_us10_stock_value_cell_right blockoverride "text" { text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_wheat_overproduction_percent').GetValue|2]%" } } } blockoverride "production_efficiency" { text_single = { using = modeu5_us10_stock_value_cell_right blockoverride "text" { raw_text = "n/a" } } } }
					hbox = { using = modeu5_us10_stock_row visible = "[Or3(GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('modeu5_us10_ui_iron_country_stock').GetValue, '(CFixedPoint)0'), GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('modeu5_us10_ui_iron_market_stock').GetValue, '(CFixedPoint)0'), GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('modeu5_us10_ui_iron_overproduction_percent').GetValue, '(CFixedPoint)0'))]" blockoverride "good" { text_single = { using = modeu5_us10_stock_value_cell_left blockoverride "text" { raw_text = "Iron" } } } blockoverride "country_stocks" { text_single = { using = modeu5_us10_stock_value_cell_right blockoverride "text" { text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_iron_country_stock').GetValue|2]/[Player.MakeScope.GetVariable('modeu5_us10_ui_iron_country_capacity').GetValue|2]" } } } blockoverride "market_stocks" { text_single = { using = modeu5_us10_stock_value_cell_right blockoverride "text" { text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_iron_market_stock').GetValue|2]/[Player.MakeScope.GetVariable('modeu5_us10_ui_iron_market_capacity').GetValue|2]" } } } blockoverride "overproduction" { text_single = { using = modeu5_us10_stock_value_cell_right blockoverride "text" { text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_iron_overproduction_percent').GetValue|2]%" } } } blockoverride "production_efficiency" { text_single = { using = modeu5_us10_stock_value_cell_right blockoverride "text" { raw_text = "n/a" } } } }
					hbox = { using = modeu5_us10_stock_row visible = "[Or3(GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('modeu5_us10_ui_tools_country_stock').GetValue, '(CFixedPoint)0'), GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('modeu5_us10_ui_tools_market_stock').GetValue, '(CFixedPoint)0'), GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('modeu5_us10_ui_tools_overproduction_percent').GetValue, '(CFixedPoint)0'))]" blockoverride "good" { text_single = { using = modeu5_us10_stock_value_cell_left blockoverride "text" { raw_text = "Tools" } } } blockoverride "country_stocks" { text_single = { using = modeu5_us10_stock_value_cell_right blockoverride "text" { text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_tools_country_stock').GetValue|2]/[Player.MakeScope.GetVariable('modeu5_us10_ui_tools_country_capacity').GetValue|2]" } } } blockoverride "market_stocks" { text_single = { using = modeu5_us10_stock_value_cell_right blockoverride "text" { text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_tools_market_stock').GetValue|2]/[Player.MakeScope.GetVariable('modeu5_us10_ui_tools_market_capacity').GetValue|2]" } } } blockoverride "overproduction" { text_single = { using = modeu5_us10_stock_value_cell_right blockoverride "text" { text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_tools_overproduction_percent').GetValue|2]%" } } } blockoverride "production_efficiency" { text_single = { using = modeu5_us10_stock_value_cell_right blockoverride "text" { raw_text = "n/a" } } } }
				}
			}
		}
	}
}
