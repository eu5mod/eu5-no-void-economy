# ModeU5 US-10 reusable stock table templates.
#
# Kept separate from the Plan A mounting point so the table can be reused if
# Plan B later generates a full production_lateralview.gui override.
#
# US-10 spec columns:
# Good | Country Stocks | Market Stocks | Overproduction | Production Efficiency
#
# V0 intentionally keeps a compact row set while the UI mounting/sync path is
# still being stabilised. Row visibility is production-based for the selected
# market; stored stock alone must not make a Production row appear.

template modeu5_us10_stock_header_cell_good {
	layoutpolicy_horizontal = fixed
	minimumsize = { 38 22 }
	maximumsize = { 38 22 }
	autoresize = no
	align = center|nobaseline
	fontsize = 11
	default_format = "#bold"
	block "text" { raw_text = "" }
}

template modeu5_us10_stock_header_cell_stock {
	layoutpolicy_horizontal = fixed
	minimumsize = { 84 22 }
	maximumsize = { 84 22 }
	autoresize = no
	align = right|nobaseline
	fontsize = 11
	default_format = "#bold"
	block "text" { raw_text = "" }
}

template modeu5_us10_stock_header_cell_overproduction {
	layoutpolicy_horizontal = fixed
	minimumsize = { 74 22 }
	maximumsize = { 74 22 }
	autoresize = no
	align = right|nobaseline
	fontsize = 11
	default_format = "#bold"
	block "text" { raw_text = "" }
}

template modeu5_us10_stock_header_cell_efficiency {
	layoutpolicy_horizontal = fixed
	minimumsize = { 62 22 }
	maximumsize = { 62 22 }
	autoresize = no
	align = right|nobaseline
	fontsize = 11
	default_format = "#bold"
	block "text" { raw_text = "" }
}

template modeu5_us10_stock_value_cell_stock {
	layoutpolicy_horizontal = fixed
	minimumsize = { 84 22 }
	maximumsize = { 84 22 }
	autoresize = no
	align = right|nobaseline
	fontsize = 12
	block "text" { raw_text = "" }
}

template modeu5_us10_stock_value_cell_overproduction {
	layoutpolicy_horizontal = fixed
	minimumsize = { 74 22 }
	maximumsize = { 74 22 }
	autoresize = no
	align = right|nobaseline
	fontsize = 12
	block "text" { raw_text = "" }
}

template modeu5_us10_stock_value_cell_efficiency {
	layoutpolicy_horizontal = fixed
	minimumsize = { 62 22 }
	maximumsize = { 62 22 }
	autoresize = no
	align = right|nobaseline
	fontsize = 12
	block "text" { raw_text = "" }
}

template modeu5_us10_stock_good_icon_cell {
	layoutpolicy_horizontal = fixed
	minimumsize = { 38 24 }
	maximumsize = { 38 24 }

	icon = {
		parentanchor = center
		size = { 22 22 }
		texture = "gfx/interface/icons/trade_goods/icon_goods_wheat.dds"
		texture_density = 2
	}
}

template modeu5_us10_stock_row {
	layoutpolicy_horizontal = fixed
	layoutpolicy_vertical = fixed
	minimumsize = { 370 26 }
	maximumsize = { 370 26 }
	spacing = 4

	block "good" {
		widget = {
			using = modeu5_us10_stock_good_icon_cell
		}
	}
	block "country_stocks" { text_single = { using = modeu5_us10_stock_value_cell_stock } }
	block "market_stocks" { text_single = { using = modeu5_us10_stock_value_cell_stock } }
	block "overproduction" { text_single = { using = modeu5_us10_stock_value_cell_overproduction } }
	block "production_efficiency" { text_single = { using = modeu5_us10_stock_value_cell_efficiency } }
}

template modeu5_us10_stock_table {
	layoutpolicy_horizontal = expanding
	layoutpolicy_vertical = expanding
	using = bg_window_default_alt

	vbox = {
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding
		margin = { 8 8 }
		spacing = 5

		hbox = {
			layoutpolicy_horizontal = fixed
			layoutpolicy_vertical = fixed
			minimumsize = { 370 24 }
			maximumsize = { 370 24 }
			spacing = 4
			text_single = { using = modeu5_us10_stock_header_cell_good blockoverride "text" { raw_text = "Good" } }
			text_single = { using = modeu5_us10_stock_header_cell_stock blockoverride "text" { raw_text = "Country" } }
			text_single = { using = modeu5_us10_stock_header_cell_stock blockoverride "text" { raw_text = "Market" } }
			text_single = { using = modeu5_us10_stock_header_cell_overproduction blockoverride "text" { raw_text = "Overprod." } }
			text_single = { using = modeu5_us10_stock_header_cell_efficiency blockoverride "text" { raw_text = "Eff." } }
		}

		scrollarea = {
			using = layoutpolicy_expanding
			scrollbarpolicy_horizontal = always_off
			autoresizescrollarea = no

			scrollbar_vertical = { using = Scrollbar_Vertical }

			scrollwidget = {
				vbox = {
					layoutpolicy_horizontal = fixed
					set_parent_dimension_to_minimum = height
					spacing = 2

					hbox = {
						using = modeu5_us10_stock_row
						visible = "[GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('modeu5_us10_ui_cotton_produced_by_market').GetValue, '(CFixedPoint)0')]"
						blockoverride "good" { widget = { using = modeu5_us10_stock_good_icon_cell icon = { parentanchor = center size = { 22 22 } texture = "gfx/interface/icons/trade_goods/icon_goods_cotton.dds" texture_density = 2 } } }
						blockoverride "country_stocks" { text_single = { using = modeu5_us10_stock_value_cell_stock blockoverride "text" { raw_text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_cotton_country_stock').GetValue|2]/[Player.MakeScope.GetVariable('modeu5_us10_ui_cotton_country_capacity').GetValue|2]" } } }
						blockoverride "market_stocks" { text_single = { using = modeu5_us10_stock_value_cell_stock blockoverride "text" { raw_text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_cotton_market_stock').GetValue|2]/[Player.MakeScope.GetVariable('modeu5_us10_ui_cotton_market_capacity').GetValue|2]" } } }
						blockoverride "overproduction" { text_single = { using = modeu5_us10_stock_value_cell_overproduction blockoverride "text" { raw_text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_cotton_overproduction_percent').GetValue|2]%" } } }
						blockoverride "production_efficiency" { text_single = { using = modeu5_us10_stock_value_cell_efficiency blockoverride "text" { raw_text = "n/a" } } }
					}

					hbox = {
						using = modeu5_us10_stock_row
						visible = "[GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('modeu5_us10_ui_sugar_produced_by_market').GetValue, '(CFixedPoint)0')]"
						blockoverride "good" { widget = { using = modeu5_us10_stock_good_icon_cell icon = { parentanchor = center size = { 22 22 } texture = "gfx/interface/icons/trade_goods/icon_goods_sugar.dds" texture_density = 2 } } }
						blockoverride "country_stocks" { text_single = { using = modeu5_us10_stock_value_cell_stock blockoverride "text" { raw_text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_sugar_country_stock').GetValue|2]/[Player.MakeScope.GetVariable('modeu5_us10_ui_sugar_country_capacity').GetValue|2]" } } }
						blockoverride "market_stocks" { text_single = { using = modeu5_us10_stock_value_cell_stock blockoverride "text" { raw_text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_sugar_market_stock').GetValue|2]/[Player.MakeScope.GetVariable('modeu5_us10_ui_sugar_market_capacity').GetValue|2]" } } }
						blockoverride "overproduction" { text_single = { using = modeu5_us10_stock_value_cell_overproduction blockoverride "text" { raw_text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_sugar_overproduction_percent').GetValue|2]%" } } }
						blockoverride "production_efficiency" { text_single = { using = modeu5_us10_stock_value_cell_efficiency blockoverride "text" { raw_text = "n/a" } } }
					}

					hbox = {
						using = modeu5_us10_stock_row
						visible = "[GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('modeu5_us10_ui_tobacco_produced_by_market').GetValue, '(CFixedPoint)0')]"
						blockoverride "good" { widget = { using = modeu5_us10_stock_good_icon_cell icon = { parentanchor = center size = { 22 22 } texture = "gfx/interface/icons/trade_goods/icon_goods_tobacco.dds" texture_density = 2 } } }
						blockoverride "country_stocks" { text_single = { using = modeu5_us10_stock_value_cell_stock blockoverride "text" { raw_text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_tobacco_country_stock').GetValue|2]/[Player.MakeScope.GetVariable('modeu5_us10_ui_tobacco_country_capacity').GetValue|2]" } } }
						blockoverride "market_stocks" { text_single = { using = modeu5_us10_stock_value_cell_stock blockoverride "text" { raw_text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_tobacco_market_stock').GetValue|2]/[Player.MakeScope.GetVariable('modeu5_us10_ui_tobacco_market_capacity').GetValue|2]" } } }
						blockoverride "overproduction" { text_single = { using = modeu5_us10_stock_value_cell_overproduction blockoverride "text" { raw_text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_tobacco_overproduction_percent').GetValue|2]%" } } }
						blockoverride "production_efficiency" { text_single = { using = modeu5_us10_stock_value_cell_efficiency blockoverride "text" { raw_text = "n/a" } } }
					}

					hbox = {
						using = modeu5_us10_stock_row
						visible = "[GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('modeu5_us10_ui_tar_produced_by_market').GetValue, '(CFixedPoint)0')]"
						blockoverride "good" { widget = { using = modeu5_us10_stock_good_icon_cell icon = { parentanchor = center size = { 22 22 } texture = "gfx/interface/icons/trade_goods/icon_goods_tar.dds" texture_density = 2 } } }
						blockoverride "country_stocks" { text_single = { using = modeu5_us10_stock_value_cell_stock blockoverride "text" { raw_text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_tar_country_stock').GetValue|2]/[Player.MakeScope.GetVariable('modeu5_us10_ui_tar_country_capacity').GetValue|2]" } } }
						blockoverride "market_stocks" { text_single = { using = modeu5_us10_stock_value_cell_stock blockoverride "text" { raw_text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_tar_market_stock').GetValue|2]/[Player.MakeScope.GetVariable('modeu5_us10_ui_tar_market_capacity').GetValue|2]" } } }
						blockoverride "overproduction" { text_single = { using = modeu5_us10_stock_value_cell_overproduction blockoverride "text" { raw_text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_tar_overproduction_percent').GetValue|2]%" } } }
						blockoverride "production_efficiency" { text_single = { using = modeu5_us10_stock_value_cell_efficiency blockoverride "text" { raw_text = "n/a" } } }
					}

					hbox = {
						using = modeu5_us10_stock_row
						visible = "[GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('modeu5_us10_ui_porcelain_produced_by_market').GetValue, '(CFixedPoint)0')]"
						blockoverride "good" { widget = { using = modeu5_us10_stock_good_icon_cell icon = { parentanchor = center size = { 22 22 } texture = "gfx/interface/icons/trade_goods/icon_goods_porcelain.dds" texture_density = 2 } } }
						blockoverride "country_stocks" { text_single = { using = modeu5_us10_stock_value_cell_stock blockoverride "text" { raw_text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_porcelain_country_stock').GetValue|2]/[Player.MakeScope.GetVariable('modeu5_us10_ui_porcelain_country_capacity').GetValue|2]" } } }
						blockoverride "market_stocks" { text_single = { using = modeu5_us10_stock_value_cell_stock blockoverride "text" { raw_text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_porcelain_market_stock').GetValue|2]/[Player.MakeScope.GetVariable('modeu5_us10_ui_porcelain_market_capacity').GetValue|2]" } } }
						blockoverride "overproduction" { text_single = { using = modeu5_us10_stock_value_cell_overproduction blockoverride "text" { raw_text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_porcelain_overproduction_percent').GetValue|2]%" } } }
						blockoverride "production_efficiency" { text_single = { using = modeu5_us10_stock_value_cell_efficiency blockoverride "text" { raw_text = "n/a" } } }
					}

					hbox = {
						using = modeu5_us10_stock_row
						visible = "[GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('modeu5_us10_ui_naval_supplies_produced_by_market').GetValue, '(CFixedPoint)0')]"
						blockoverride "good" { widget = { using = modeu5_us10_stock_good_icon_cell icon = { parentanchor = center size = { 22 22 } texture = "gfx/interface/icons/trade_goods/icon_goods_naval_supplies.dds" texture_density = 2 } } }
						blockoverride "country_stocks" { text_single = { using = modeu5_us10_stock_value_cell_stock blockoverride "text" { raw_text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_naval_supplies_country_stock').GetValue|2]/[Player.MakeScope.GetVariable('modeu5_us10_ui_naval_supplies_country_capacity').GetValue|2]" } } }
						blockoverride "market_stocks" { text_single = { using = modeu5_us10_stock_value_cell_stock blockoverride "text" { raw_text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_naval_supplies_market_stock').GetValue|2]/[Player.MakeScope.GetVariable('modeu5_us10_ui_naval_supplies_market_capacity').GetValue|2]" } } }
						blockoverride "overproduction" { text_single = { using = modeu5_us10_stock_value_cell_overproduction blockoverride "text" { raw_text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_naval_supplies_overproduction_percent').GetValue|2]%" } } }
						blockoverride "production_efficiency" { text_single = { using = modeu5_us10_stock_value_cell_efficiency blockoverride "text" { raw_text = "n/a" } } }
					}

					hbox = {
						using = modeu5_us10_stock_row
						visible = "[GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('modeu5_us10_ui_wheat_produced_by_market').GetValue, '(CFixedPoint)0')]"
						blockoverride "good" { widget = { using = modeu5_us10_stock_good_icon_cell icon = { parentanchor = center size = { 22 22 } texture = "gfx/interface/icons/trade_goods/icon_goods_wheat.dds" texture_density = 2 } } }
						blockoverride "country_stocks" { text_single = { using = modeu5_us10_stock_value_cell_stock blockoverride "text" { raw_text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_wheat_country_stock').GetValue|2]/[Player.MakeScope.GetVariable('modeu5_us10_ui_wheat_country_capacity').GetValue|2]" } } }
						blockoverride "market_stocks" { text_single = { using = modeu5_us10_stock_value_cell_stock blockoverride "text" { raw_text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_wheat_market_stock').GetValue|2]/[Player.MakeScope.GetVariable('modeu5_us10_ui_wheat_market_capacity').GetValue|2]" } } }
						blockoverride "overproduction" { text_single = { using = modeu5_us10_stock_value_cell_overproduction blockoverride "text" { raw_text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_wheat_overproduction_percent').GetValue|2]%" } } }
						blockoverride "production_efficiency" { text_single = { using = modeu5_us10_stock_value_cell_efficiency blockoverride "text" { raw_text = "n/a" } } }
					}

					hbox = {
						using = modeu5_us10_stock_row
						visible = "[GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('modeu5_us10_ui_iron_produced_by_market').GetValue, '(CFixedPoint)0')]"
						blockoverride "good" { widget = { using = modeu5_us10_stock_good_icon_cell icon = { parentanchor = center size = { 22 22 } texture = "gfx/interface/icons/trade_goods/icon_goods_iron.dds" texture_density = 2 } } }
						blockoverride "country_stocks" { text_single = { using = modeu5_us10_stock_value_cell_stock blockoverride "text" { raw_text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_iron_country_stock').GetValue|2]/[Player.MakeScope.GetVariable('modeu5_us10_ui_iron_country_capacity').GetValue|2]" } } }
						blockoverride "market_stocks" { text_single = { using = modeu5_us10_stock_value_cell_stock blockoverride "text" { raw_text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_iron_market_stock').GetValue|2]/[Player.MakeScope.GetVariable('modeu5_us10_ui_iron_market_capacity').GetValue|2]" } } }
						blockoverride "overproduction" { text_single = { using = modeu5_us10_stock_value_cell_overproduction blockoverride "text" { raw_text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_iron_overproduction_percent').GetValue|2]%" } } }
						blockoverride "production_efficiency" { text_single = { using = modeu5_us10_stock_value_cell_efficiency blockoverride "text" { raw_text = "n/a" } } }
					}

					hbox = {
						using = modeu5_us10_stock_row
						visible = "[GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('modeu5_us10_ui_tools_produced_by_market').GetValue, '(CFixedPoint)0')]"
						blockoverride "good" { widget = { using = modeu5_us10_stock_good_icon_cell icon = { parentanchor = center size = { 22 22 } texture = "gfx/interface/icons/trade_goods/icon_goods_tools.dds" texture_density = 2 } } }
						blockoverride "country_stocks" { text_single = { using = modeu5_us10_stock_value_cell_stock blockoverride "text" { raw_text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_tools_country_stock').GetValue|2]/[Player.MakeScope.GetVariable('modeu5_us10_ui_tools_country_capacity').GetValue|2]" } } }
						blockoverride "market_stocks" { text_single = { using = modeu5_us10_stock_value_cell_stock blockoverride "text" { raw_text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_tools_market_stock').GetValue|2]/[Player.MakeScope.GetVariable('modeu5_us10_ui_tools_market_capacity').GetValue|2]" } } }
						blockoverride "overproduction" { text_single = { using = modeu5_us10_stock_value_cell_overproduction blockoverride "text" { raw_text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_tools_overproduction_percent').GetValue|2]%" } } }
						blockoverride "production_efficiency" { text_single = { using = modeu5_us10_stock_value_cell_efficiency blockoverride "text" { raw_text = "n/a" } } }
					}
				}
			}
		}
	}
}
