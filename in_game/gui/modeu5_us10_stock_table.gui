# ModeU5 US-10 reusable stock table templates.
#
# Kept separate from the Plan A mounting point so the table can be reused if
# Plan B later generates a full production_lateralview.gui override.
#
# US-10 spec columns:
# Good | Country Stocks | Market Stocks | Overproduction | Production Efficiency
#
# Rows are generated for every ModeU5 stock good captured by the read-model and
# hidden unless the selected country/market read-model reports a stock or
# overproduction signal. Do not filter on *_produced here: the US-00 produced
# ledger is a ModeU5 transaction counter and does not read vanilla production
# directly yet.

template modeu5_us10_stock_header_cell {
	layoutpolicy_horizontal = expanding
	layoutstretchfactor_horizontal = 1
	autoresize = no
	align = left|nobaseline
	fontsize = 12
	default_format = "#bold"
	block "text" { raw_text = "" }
}

template modeu5_us10_stock_value_cell {
	layoutpolicy_horizontal = expanding
	layoutstretchfactor_horizontal = 1
	autoresize = no
	align = left|nobaseline
	fontsize = 13
	block "text" { raw_text = "" }
}

template modeu5_us10_stock_row {
	layoutpolicy_horizontal = expanding
	spacing = 8
	block "good" { text_single = { using = modeu5_us10_stock_value_cell } }
	block "country_stocks" { text_single = { using = modeu5_us10_stock_value_cell } }
	block "market_stocks" { text_single = { using = modeu5_us10_stock_value_cell } }
	block "overproduction" { text_single = { using = modeu5_us10_stock_value_cell } }
	block "production_efficiency" { text_single = { using = modeu5_us10_stock_value_cell } }
}

template modeu5_us10_stock_table {
	layoutpolicy_horizontal = expanding
	layoutpolicy_vertical = expanding
	using = bg_window_default_alt

	vbox = {
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding
		margin = { 10 8 }
		spacing = 7

		hbox = {
			layoutpolicy_horizontal = expanding
			spacing = 8
			text_single = { using = modeu5_us10_stock_header_cell blockoverride "text" { raw_text = "Good" } }
			text_single = { using = modeu5_us10_stock_header_cell blockoverride "text" { raw_text = "Country Stocks" } }
			text_single = { using = modeu5_us10_stock_header_cell blockoverride "text" { raw_text = "Market Stocks" } }
			text_single = { using = modeu5_us10_stock_header_cell blockoverride "text" { raw_text = "Overproduction" } }
			text_single = { using = modeu5_us10_stock_header_cell blockoverride "text" { raw_text = "Production Efficiency" } }
		}

		scrollarea = {
			using = layoutpolicy_expanding
			scrollbarpolicy_horizontal = always_off
			autoresizescrollarea = no

			scrollbar_vertical = {
				using = Scrollbar_Vertical
			}

			scrollwidget = {
				vbox = {
					layoutpolicy_horizontal = expanding
					spacing = 5

					hbox = {
						using = modeu5_us10_stock_row
						visible = "[Or3(GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('modeu5_us10_ui_cotton_country_stock').GetValue, '(CFixedPoint)0'), GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('modeu5_us10_ui_cotton_market_stock').GetValue, '(CFixedPoint)0'), GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('modeu5_us10_ui_cotton_overproduction_percent').GetValue, '(CFixedPoint)0'))]"
						blockoverride "good" { text_single = { using = modeu5_us10_stock_value_cell blockoverride "text" { raw_text = "Cotton" } } }
						blockoverride "country_stocks" { text_single = { using = modeu5_us10_stock_value_cell blockoverride "text" { text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_cotton_country_stock').GetValue|2]/[Player.MakeScope.GetVariable('modeu5_us10_ui_cotton_country_capacity').GetValue|2]" } } }
						blockoverride "market_stocks" { text_single = { using = modeu5_us10_stock_value_cell blockoverride "text" { text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_cotton_market_stock').GetValue|2]/[Player.MakeScope.GetVariable('modeu5_us10_ui_cotton_market_capacity').GetValue|2]" } } }
						blockoverride "overproduction" { text_single = { using = modeu5_us10_stock_value_cell blockoverride "text" { raw_text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_cotton_overproduction_percent').GetValue|2]%" } } }
						blockoverride "production_efficiency" { text_single = { using = modeu5_us10_stock_value_cell blockoverride "text" { raw_text = "n/a" } } }
					}

					hbox = {
						using = modeu5_us10_stock_row
						visible = "[Or3(GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('modeu5_us10_ui_sugar_country_stock').GetValue, '(CFixedPoint)0'), GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('modeu5_us10_ui_sugar_market_stock').GetValue, '(CFixedPoint)0'), GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('modeu5_us10_ui_sugar_overproduction_percent').GetValue, '(CFixedPoint)0'))]"
						blockoverride "good" { text_single = { using = modeu5_us10_stock_value_cell blockoverride "text" { raw_text = "Sugar" } } }
						blockoverride "country_stocks" { text_single = { using = modeu5_us10_stock_value_cell blockoverride "text" { text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_sugar_country_stock').GetValue|2]/[Player.MakeScope.GetVariable('modeu5_us10_ui_sugar_country_capacity').GetValue|2]" } } }
						blockoverride "market_stocks" { text_single = { using = modeu5_us10_stock_value_cell blockoverride "text" { text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_sugar_market_stock').GetValue|2]/[Player.MakeScope.GetVariable('modeu5_us10_ui_sugar_market_capacity').GetValue|2]" } } }
						blockoverride "overproduction" { text_single = { using = modeu5_us10_stock_value_cell blockoverride "text" { raw_text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_sugar_overproduction_percent').GetValue|2]%" } } }
						blockoverride "production_efficiency" { text_single = { using = modeu5_us10_stock_value_cell blockoverride "text" { raw_text = "n/a" } } }
