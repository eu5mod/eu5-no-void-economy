						blockoverride "market_stocks" { text_single = { using = modeu5_us10_stock_value_cell blockoverride "text" { text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_tobacco_market_stock').GetValue|2]/[Player.MakeScope.GetVariable('modeu5_us10_ui_tobacco_market_capacity').GetValue|2]" } } }
