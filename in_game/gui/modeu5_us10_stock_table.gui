						visible = "[Or3(GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('modeu5_us10_ui_slaves_goods_country_stock').GetValue, '(CFixedPoint)0'), GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('modeu5_us10_ui_slaves_goods_market_stock').GetValue, '(CFixedPoint)0'), GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('modeu5_us10_ui_slaves_goods_overproduction_percent').GetValue, '(CFixedPoint)0'))]"
						blockoverride "good" { text_single = { using = modeu5_us10_stock_value_cell blockoverride "text" { raw_text = "Slaves" } } }
						blockoverride "country_stocks" { text_single = { using = modeu5_us10_stock_value_cell blockoverride "text" { text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_slaves_goods_country_stock').GetValue|2]/[Player.MakeScope.GetVariable('modeu5_us10_ui_slaves_goods_country_capacity').GetValue|2]" } } }
						blockoverride "market_stocks" { text_single = { using = modeu5_us10_stock_value_cell blockoverride "text" { text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_slaves_goods_market_stock').GetValue|2]/[Player.MakeScope.GetVariable('modeu5_us10_ui_slaves_goods_market_capacity').GetValue|2]" } } }
						blockoverride "overproduction" { text_single = { using = modeu5_us10_stock_value_cell blockoverride "text" { raw_text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_slaves_goods_overproduction_percent').GetValue|2]%" } } }
						blockoverride "production_efficiency" { text_single = { using = modeu5_us10_stock_value_cell blockoverride "text" { raw_text = "n/a" } } }
					}

				}
			}
		}
	}
}
