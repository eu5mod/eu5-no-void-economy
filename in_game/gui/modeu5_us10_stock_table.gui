						using = modeu5_us10_stock_row
						visible = "[Or3(GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('modeu5_us10_ui_tools_country_stock').GetValue, '(CFixedPoint)0'), GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('modeu5_us10_ui_tools_market_stock').GetValue, '(CFixedPoint)0'), GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('modeu5_us10_ui_tools_overproduction_percent').GetValue, '(CFixedPoint)0'))]"
						blockoverride "good" { widget = { using = modeu5_us10_stock_good_icon_cell icon = { parentanchor = center size = { 22 22 } texture = "gfx/interface/icons/trade_goods/icon_goods_tools.dds" texture_density = 2 } } }
						blockoverride "country_stocks" { text_single = { using = modeu5_us10_stock_value_cell_right blockoverride "text" { raw_text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_tools_country_stock').GetValue|2]/[Player.MakeScope.GetVariable('modeu5_us10_ui_tools_country_capacity').GetValue|2]" } } }
						blockoverride "market_stocks" { text_single = { using = modeu5_us10_stock_value_cell_right blockoverride "text" { raw_text = "[Player.MakeScope.GetVariable('modeu5_us10_ui_tools_market_stock').GetValue|2]/[Player.MakeScope.GetVariable('modeu5_us10_ui_tools_market_capacity').GetValue|2]" } } }
