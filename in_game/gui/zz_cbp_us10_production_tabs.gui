# US-10 minimal Production top-tab injection.
#
# Custom lateralviews are not registered through OpenLateralView. This file only
# adds a top-level ModeU5 entry that opens the existing Production lateralview
# and sets ModeU5 UI state. The actual body is mounted by
# zz_cbp_us10_production_subtabs.gui inside Production's internal content flow.

template production_main_tabs {
	button_main_tab_alt = {
		using = layoutpolicy_expanding
		tooltipwidget = {
			using = TabBuildingsTooltip
		}
		widget = {
			visible = "[Not(IsLateralViewOpened('production'))]"
			size = { 100% 100% }
			name = "tab_buildings"
		}
		down = "[And(IsLateralViewOpened('production'), Not(GetVariableSystem.Exists('cbp_us10_stock_tab')))]"
		datacontext = "[GetAutomatedSystemItem4('buildings', 'productionmethods', 'closebuildings', 'subsidizebuildings')]"
		using = multi_automated_tab

		blockoverride "on_action_left" {
			on_action = "[GetVariableSystem.Clear('cbp_us10_stock_tab')]"
			on_action = "[OpenLateralView('production')]"
		}
		blockoverride "on_action_right_title" { title = "TOGGLE_PRODUCTION_AUTOMATION" }
		blockoverride "text" { text = "PRODUCTION_TEXT" }
	}

	button_main_tab_alt = {
		using = layoutpolicy_expanding
		tooltipwidget = {
			using = TabGoodsTooltip
		}

		down = "[IsLateralViewOpened('goods_production')]"
		datacontext = "[GetAutomatedSystemItem('rgo')]"
		using = automated_tab

		blockoverride "on_action_left" {
			on_action = "[GetVariableSystem.Clear('cbp_us10_stock_tab')]"
			on_action = "[OpenLateralView('goods_production')]"
		}
		blockoverride "text" { text = "EXPAND_RAW_GOODS_TEXT" }
	}

	button_main_tab_alt = {
		using = layoutpolicy_expanding
		blockoverride "tab_text" {
			text = "FOOD_PRODUCTION_TEXT"
		}
		onclick = "[GetVariableSystem.Clear('cbp_us10_stock_tab')]"
		onclick = "[OpenLateralView('food_production')]"
		down = "[IsLateralViewOpened('food_production')]"
		tooltipwidget = {
			using = TabFoodTooltip
		}
	}

	button_main_tab_alt = {
		using = layoutpolicy_expanding
		blockoverride "tab_text" {
			text = "game_concept_locations"
		}
		onclick = "[GetVariableSystem.Clear('cbp_us10_stock_tab')]"
		onclick = "[OpenLateralView('town_rights')]"
		down = "[IsLateralViewOpened('town_rights')]"
		tooltipwidget = {
			using = TabTownRightsTooltip
		}
	}

	button_main_tab_alt = {
		using = layoutpolicy_expanding
		blockoverride "tab_text" {
			text = "cbp_us10_ui.tab"
		}
		# Keep ModeU5 as a sub-mode of the existing production lateralview.
		# Opening from the top tab cannot access ProductionView.GetSelectedMarket,
		# so this only refreshes/validates the existing ModeU5 selected market.
		# The inline Sync button uses the actual Production selected market context.
		onclick = "[OpenLateralView('production')]"
		onclick = "[GetVariableSystem.Set('cbp_us10_stock_tab', 'yes')]"
		onclick = "[GetScriptedGui('cbp_us10_ui_refresh_on_click').Execute(GuiScope.SetRoot(Player.MakeScope).End)]"
		down = "[And(IsLateralViewOpened('production'), GetVariableSystem.Exists('cbp_us10_stock_tab'))]"
		tooltipwidget = {
			BasicFunctionalTooltip = {}
		}
	}
}
